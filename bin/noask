#!/usr/bin/env bash
# noask: the switch under which an agent stops asking the owner and rules for
# itself, by the rule text in scripts/noask-rule.md. This command is the only
# writer of the switch's markers and of the sessions' records; the plugin's
# module and hooks read the markers, never a record, and change a record only
# through count. It is reached through links from a terminal's PATH, so it
# finds the plugin root from its own path with every symbolic link resolved.
#
# Usage:
#   noask [--session <id>] [status]
#   noask --session <id> on [handsoff] [<expiry>]
#   noask --session <id> off
#   noask [--session <id>] global on [<expiry>]
#   noask [--session <id>] global off
#   noask --session <id> [--agent <agent id>] count question|denial|continuation <budget>
#   noask --session <id> [--agent <agent id>] count reset
#   noask --session <id> [--agent <agent id>] count read
#   <expiry> is <n>h or <n>m (<n> from 1 to 99999), or `until HH:MM`: the
#   next such local time strictly after now (in an hour a clock change
#   repeats, the earlier of its two passes still ahead), refused (exit 2)
#   when a clock change skips it on that day. The marker stores the absolute
#   time. <budget> is 1 to 99999 (^[1-9][0-9]{0,4}$); an <agent id> matches
#   ^[A-Za-z0-9_-]{1,64}$. No person types count: the plugin's hooks call it.
#
# The session S the command acts for is the --session value, which comes
# first, must match ^[A-Za-z0-9_-]{1,64}$ and must be none of the command's
# own words (RESERVED; `--session on` is a wrong argument, whatever
# follows); else, for status and the bare command only,
# CLAUDE_CODE_SESSION_ID when it has that form; else none. `on` and `off`
# without --session are refused: a session's switch is typed in the session
# (/noask on), and `noask global on` switches every session.
#
# The platform is Linux with bash 5, GNU coreutils and flock; for coreutils
# the command tests the one thing it needs that BSD's date lacks, a date
# that reads -d @<epoch> (GNU's and uutils' do). Off the platform no marker
# can exist: status, with or without --session, prints off and the bare
# command "noask: off", exit 0; every other form exits 1 with a line that
# says so and writes nothing.
#
# Markers: the global one is $HOME/.local/state/sdd/noask, a session's is
# $HOME/.local/state/sdd/noask.d/<id>. Each holds four lines:
#   generation=<local ISO-8601 time, nine fractional digits, numeric offset>-<8 hex>
#   since=<local ISO-8601 time to the second, numeric offset>
#   until=<the same form, or empty; never empty in a session's marker>
#   level=<noask or handsoff; always noask in the global marker>
# A numeric offset is [+-]HH:MM from 00:00 to 14:00 (OFFSET_RE): no real
# offset is past 14 hours, and the plugin's module refuses a minute past 59,
# which date carries into the hour (+04:60 as +05:00).
# A reading of one marker is off (no file), on, expired (an until not after
# now; read as off) or unreadable (the file exists and cannot be read within
# 2 seconds, is longer than 4096 bytes, or does not parse). S's reading is
# the global marker's when that is on or unreadable, else S's own when that
# is not off, else the global marker's; with no S, the global marker's
# alone. With HOME unset or empty every reading is off.
#
# Records: a session's is $HOME/.local/state/sdd/budgets.d/<id>, a
# subagent's budgets.d/<id>.<agent id>. Each holds five lines:
#   generation=<the generation of the marker S reads, or empty>
#   refusals=<n>
#   denials=<n>
#   continuations=<n>
#   spent=<none, question, permission or continuation>
# <n> is 0 to 99999. A record that is longer than 4096 bytes or does not
# parse is started again as an empty one, with a line on standard error that
# says so. A record that exists and cannot be read within 2 seconds is not:
# the count fails (exit 1) and leaves it as it is, since starting it again
# would clear a spent budget inside its generation.
#
# count charges S's record, or its subagent's. When S reads off or expired it
# prints off and makes nothing. Otherwise it makes budgets.d (mode 700), takes
# its lock budgets.d/.lock (flock, 2 seconds; never the switch's lock), reads
# S again under it and acts on that second reading: off or expired prints off
# and writes no record; on, with no record or one of another generation,
# starts an empty record under the reading's generation; on under the
# record's generation, or unreadable, keeps the record and its generation (an
# empty one for a new record). Then question, denial and continuation add one
# to refusals, denials and continuations while spent is none, and set spent
# to question, permission and continuation when that counter reaches
# <budget>; reset zeroes the three counters while spent is none; read writes
# nothing. A record is written as a marker is (a temporary .noask.* file
# renamed over it, then read back), and count prints the record as it then
# stands: "counted <spent> <refusals> <denials> <continuations>".
#
# Output. status: one line, off, on <generation>[ until <until>], expired
# <until> or unreadable <reason>; the on and unreadable lines end in
# " handsoff" when S's own marker reads on at that level. The bare command
# with an S: a line for each switch that is on, the global one first, else
# "noask: off" or "noask: off (expired <time>)"; without an S (a terminal):
# the global switch's line, then one line per session marker that reads on,
# then one per session marker that is unreadable. A switching command prints
# what it did and, when it wrote a marker, the marker's path; a new `on` adds
# an empty line and the rule text; a session's `on` beside an unreadable
# global marker ends its first line saying that marker holds every session.
# Last come the narrowing lines, "noask: narrowed <path> to the owner (it
# was <octal mode>)". <time> is HH:MM on today's local date, else
# YYYY-MM-DD HH:MM.
#
# A switching command checks its arguments, makes the state directory (mode
# 700, as it makes noask.d; it never makes budgets.d), takes the lock
# <state directory>/lock (flock, 5 seconds), narrows to the owner each of
# the state directory, noask.d and budgets.d that grants its group or others
# any bit (chmod go-rwx; a mode with no such bit, 500 included, is left as
# it is), reads its target marker, switches it (a write goes to a temporary
# .noask.* file renamed over the marker, then is read back with the parser
# status uses), prints its lines, and then sweeps: it removes each session
# marker that reads expired and each leftover .noask.* file in both
# directories; then, when budgets.d exists and its lock is free (flock -n,
# taken after the state directory's), each file of budgets.d but .lock whose
# generation= line names no marker that reads on, the markers read as they
# stand after the switch, and the .noask.* files there. It removes no record
# while the global marker or a session's reads unreadable, or while noask.d
# exists and cannot be listed and searched: a record made under such a marker
# carries a generation no reading can match, and removing it would start a
# spent budget again. A failed sweep changes neither the output nor the exit.
# status and the bare command take no lock, change no mode and write
# nothing.
#
# Exit codes: 0 done (a switch made, whatever the marker held before; a
# count's off or counted line); 1 the state directory, the lock, or a
# marker's write, read-back or removal failed, or a count could not make
# budgets.d, take its lock, or read, write or read back its record, or a
# switching command found HOME unset or empty, or any form but status and
# the bare command ran off the platform; 2 a wrong argument on the platform,
# nothing touched; 3 status or the bare command met an unreadable marker.
#
# Test seams: SDD_NOASK_NOW=<epoch seconds> replaces the clock;
# SDD_NOASK_LOCK_WAIT=<seconds> replaces the lock's 5 and the count's 2. Either
# set to the empty string reads as unset.
set -uo pipefail
shopt -s nullglob
export LC_ALL=C

readonly SESSION_HOURS=8 # a session's switch given no expiry ends this many hours after since
readonly LOCK_SECONDS=5  # how long a switching command waits for the lock
readonly COUNT_LOCK_SECONDS=2 # how long a count waits for the records' lock
readonly READ_SECONDS=2  # a marker or record read that takes longer reads unreadable
readonly MARKER_BYTES=4096 # a longer marker reads unreadable
readonly RECORD_BYTES=4096 # a longer record does not parse
readonly ID_RE='^[A-Za-z0-9_-]{1,64}$'
# The command's own words, never a session id.
readonly RESERVED='status on off global handsoff until count reset read question denial continuation'
readonly OFFSET_RE='[+-]((0[0-9]|1[0-3]):[0-5][0-9]|14:00)' # 00:00 to 14:00, either sign
readonly TIME_RE='[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}'"$OFFSET_RE"
readonly GENERATION='[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{9}'"$OFFSET_RE"'-[0-9a-f]{8}'
readonly GEN_RE="^generation=$GENERATION\$"
readonly SINCE_RE="^since=$TIME_RE\$"
readonly UNTIL_RE="^until=($TIME_RE)?\$"
readonly RECORD_GEN_RE="^generation=($GENERATION)?\$" # a record's generation may be empty
readonly COUNTER='(0|[1-9][0-9]{0,4})'                 # a record's counter, 0 to 99999

usage() {
  echo 'usage: noask [--session <id>] [status | on [handsoff] [<expiry>] | off | global on [<expiry>] | global off], <expiry> being <n>h, <n>m or until HH:MM;' \
    'noask --session <id> [--agent <agent id>] count question|denial|continuation <budget> | count reset | count read' >&2
  exit 2
}
die() {
  printf 'noask: %s\n' "$1" >&2
  exit 1
}
# is_session_id WORD: WORD matches ID_RE and is none of the RESERVED words.
is_session_id() { [[ $1 =~ $ID_RE ]] && [[ " $RESERVED " != *" $1 "* ]]; }

# The platform, tested before anything that needs it and with nothing newer
# than bash 3.2 reads: bash 5, flock, and a date that reads -d @<epoch>.
# Off it no marker can exist, so status and the bare command read off and
# every other form is refused.
if [ "${BASH_VERSINFO[0]}" -lt 5 ] || ! command -v flock > /dev/null 2>&1 ||
  [ "$(date -d @0 +%s 2> /dev/null)" != 0 ]; then
  if [ "${1-}" = --session ] && [ $# -ge 2 ] && [ "$2" != --session ] && is_session_id "$2"; then shift 2; fi
  case $#/${1-} in
    0/) echo 'noask: off' ;;
    1/status) echo off ;;
    *) die 'this command needs Linux with bash 5, GNU coreutils and flock; noask is not available here' ;;
  esac
  exit 0
fi

RULE=$(dirname -- "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")")/scripts/noask-rule.md
readonly RULE

# Parse the arguments of an `on` after the word on: [handsoff] [<expiry>].
parse_on() {
  if [ "${1-}" = handsoff ]; then
    if [ "$scope" = global ]; then
      echo "noask: handsoff is a session's level; type /noask on handsoff in the session that may publish" >&2
      exit 2
    fi
    handsoff=1
    shift
  fi
  case $# in
    0) ;;
    1) [[ $1 =~ ^[1-9][0-9]{0,4}[hm]$ ]] || usage; expiry=$1 ;;
    2) { [ "$1" = until ] && [[ $2 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; } || usage; expiry="until $2" ;;
    *) usage ;;
  esac
}

session='' given='' action='' scope='' handsoff='' expiry='' agent='' count_word='' budget=''
if [ "${1-}" = --session ]; then
  { [ $# -ge 2 ] && [ "$2" != --session ] && is_session_id "$2"; } || usage
  session=$2 given=1
  shift 2
  if [ "${1-}" = --agent ]; then
    { [ $# -ge 3 ] && [ "$2" != --agent ] && [[ $2 =~ $ID_RE ]] && [ "$3" = count ]; } || usage
    agent=$2
    shift 2
  fi
fi
case ${1-} in
  count)
    [ -n "$given" ] || usage
    case $#/${2-} in
      3/question | 3/denial | 3/continuation) [[ $3 =~ ^[1-9][0-9]{0,4}$ ]] || usage; budget=$3 ;;
      2/reset | 2/read) ;;
      *) usage ;;
    esac
    action=count count_word=$2
    ;;
  '') action=show ;;
  status) [ $# -eq 1 ] || usage; action=status ;;
  on | off)
    if [ -z "$given" ]; then
      echo "noask: a session's switch is typed in the session as /noask on; noask global on switches every session" >&2
      exit 2
    fi
    action=$1 scope=session
    shift
    if [ "$action" = on ]; then parse_on "$@"; elif [ $# -ne 0 ]; then usage; fi
    ;;
  global)
    case ${2-} in
      on) action=on scope=global; shift 2; parse_on "$@" ;;
      off) [ $# -eq 2 ] || usage; action=off scope=global ;;
      *) usage ;;
    esac
    ;;
  *) usage ;;
esac
if [ -z "$given" ] && [ -z "$scope" ] && is_session_id "${CLAUDE_CODE_SESSION_ID:-}"; then
  session=$CLAUDE_CODE_SESSION_ID
fi

# The clock, read once: now (epoch seconds), today and the local HH:MM, and
# the local time with its offset (stamp) and nanoseconds for a new marker.
if [ -n "${SDD_NOASK_NOW:-}" ]; then
  [[ $SDD_NOASK_NOW =~ ^[0-9]+$ ]] || die 'SDD_NOASK_NOW is not epoch seconds'
  clock=$(date -d "@$SDD_NOASK_NOW" +'%s %F %H:%M %Y-%m-%dT%H:%M:%S%:z %N')
else
  clock=$(date +'%s %F %H:%M %Y-%m-%dT%H:%M:%S%:z %N')
fi || die 'cannot read the clock'
[[ $clock =~ ^[0-9]+\ [0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}\ [0-9T:+-]{25}\ [0-9]{9}$ ]] ||
  die 'cannot read the clock'
read -r now today hm_now stamp nanos <<< "$clock"

iso_of() { date -d "@$1" +%Y-%m-%dT%H:%M:%S%:z; } # EPOCH as a marker's time
# at_local DAY HH:MM: the epochs, ascending, that date shows as HH:MM on DAY:
# one, or two when a clock change repeats that hour. date answers either
# pass (uutils' the first, GNU's the second), so the hour before and the
# hour after its answer are looked at too. Fails when the clock skips HH:MM
# that day (date refuses it, or answers another time of day).
at_local() {
  local out t e
  out=$(date -d "$1 $2:00" +'%s %F %H:%M' 2>/dev/null) || return 1
  [ "${out#* }" = "$1 $2" ] || return 1
  t=${out%% *}
  for e in $((t - 3600)) "$t" $((t + 3600)); do
    [ "$e" = "$t" ] || [ "$(date -d "@$e" +'%F %H:%M' 2>/dev/null)" = "$1 $2" ] || continue
    printf '%s\n' "$e"
  done
}
# Set until_epoch to the next local HH:MM strictly after now: today's
# earliest pass after now, else tomorrow's first; exit 2 when that day skips
# it.
next_local() {
  local hm=$1 t passes noon tomorrow
  if passes=$(at_local "$today" "$hm"); then
    for t in $passes; do
      if [ "$t" -gt "$now" ]; then until_epoch=$t; return; fi
    done
  elif [ $((10#${hm%:*} * 60 + 10#${hm#*:})) -gt $((10#${hm_now%:*} * 60 + 10#${hm_now#*:})) ]; then
    printf 'noask: %s does not exist on %s (a clock change skips it)\n' "$hm" "$today" >&2
    exit 2
  fi
  noon=$(date -d "$today 12:00:00" +%s) || die 'cannot read the clock'
  tomorrow=$(date -d "@$((noon + 86400))" +%F) || die 'cannot read the clock'
  if ! passes=$(at_local "$tomorrow" "$hm"); then
    printf 'noask: %s does not exist on %s (a clock change skips it)\n' "$hm" "$tomorrow" >&2
    exit 2
  fi
  until_epoch=${passes%%$'\n'*}
}

# The expiry as a marker's until (until_new), empty when none was given.
until_new=
if [ -n "$expiry" ]; then
  case $expiry in
    until\ *) next_local "${expiry#until }" ;;
    *h) until_epoch=$((now + ${expiry%h} * 3600)) ;;
    *m) until_epoch=$((now + ${expiry%m} * 60)) ;;
  esac
  until_new=$(iso_of "$until_epoch") || die 'cannot read the clock'
fi

if [ -z "${HOME:-}" ]; then
  case $action in
    status | count) echo off ;;
    show) echo 'noask: off' ;;
    *) die 'HOME is not set' ;;
  esac
  exit 0
fi
STATE=$HOME/.local/state/sdd
GLOBAL=$STATE/noask
DIR=$STATE/noask.d
BUDGETS=$STATE/budgets.d
declare -A gm=() sm=() om=() wm=() rec=() rb=() # markers read and read back; a record and its read-back
narrowed=() # the narrowing lines, printed after a switching command's own

# shown TIME: "<epoch> <time>" for a marker's TIME, <time> being HH:MM on
# today's local date, else YYYY-MM-DD HH:MM; fails when date cannot read it.
shown() {
  local out
  out=$(date -d "$1" +'%s %F %H:%M' 2>/dev/null) || return 1
  [[ $out =~ ^(-?[0-9]+)\ ([0-9-]+)\ ([0-9:]+)$ ]] || return 1
  if [ "${BASH_REMATCH[2]}" = "$today" ]; then
    printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[3]}"
  else
    printf '%s\n' "$out"
  fi
}

# read_marker FILE KIND NAME: read the marker FILE, global or session by KIND,
# into the associative array NAME: state (off, on, expired or unreadable),
# reason (when unreadable), generation, since, until and level as stored,
# and since_at and until_at as <time>. A file removed while it is read
# reads off. A marker is read to one byte past MARKER_BYTES, so one of
# exactly that size is still parsed. No reason ends in the word handsoff: a
# status line that ends in it lets a session publish.
# shellcheck disable=SC2034 # mk is a nameref: its fields land in NAME
read_marker() {
  local file=$1 kind=$2 raw rc reason='' s='' u=''
  local -a lines=()
  local -n mk=$3
  mk=(['state']=off ['reason']='' ['generation']='' ['since']='' ['until']='' ['level']='' ['since_at']=''
    ['until_at']='')
  [ -e "$file" ] || [ -L "$file" ] || return 0
  raw=$(timeout "$READ_SECONDS" head -c $((MARKER_BYTES + 1)) -- "$file" 2>/dev/null | tr '\0' '\001' && printf x)
  rc=$?
  raw=${raw%x}
  [ "$rc" -ne 0 ] || mapfile -t lines <<< "${raw%$'\n'}"
  if [ "$rc" -ne 0 ] && [ ! -e "$file" ] && [ ! -L "$file" ]; then
    return 0
  elif [ "$rc" -eq 124 ]; then
    reason='marker read timed out'
  elif [ "$rc" -ne 0 ]; then
    reason='the marker cannot be read'
  elif [ "${#raw}" -gt "$MARKER_BYTES" ]; then
    reason="the marker is longer than $MARKER_BYTES bytes"
  elif [ -z "$raw" ]; then
    reason='the marker is empty'
  elif [[ $raw != *$'\n' ]]; then
    reason='the last line has no newline'
  elif [ "${#lines[@]}" -eq 1 ]; then
    reason='the marker has 1 line, not 4'
  elif [ "${#lines[@]}" -ne 4 ]; then
    reason="the marker has ${#lines[@]} lines, not 4"
  elif ! [[ ${lines[0]} =~ $GEN_RE ]]; then
    reason='line 1 is not generation=<time>-<8 hex>'
  elif ! [[ ${lines[1]} =~ $SINCE_RE ]] || ! s=$(shown "${lines[1]#since=}"); then
    reason='line 2 is not since=<time>'
  elif ! [[ ${lines[2]} =~ $UNTIL_RE ]] || { [ "${lines[2]}" != until= ] && ! u=$(shown "${lines[2]#until=}"); }; then
    reason='line 3 is not until=<time> or until='
  elif ! [[ ${lines[3]} =~ ^level=(noask|handsoff)$ ]]; then
    reason='line 4 is not level=handsoff or level=noask'
  elif [ "$kind" = global ] && [ "${lines[3]}" = level=handsoff ]; then
    reason="level=handsoff in the global marker, which only a session's marker holds"
  elif [ "$kind" = session ] && [ "${lines[2]}" = until= ]; then
    reason="a session's marker without an until"
  fi
  if [ -n "$reason" ]; then
    mk['state']=unreadable mk['reason']=$reason
    return 0
  fi
  mk['generation']=${lines[0]#generation=} mk['since']=${lines[1]#since=}
  mk['until']=${lines[2]#until=} mk['level']=${lines[3]#level=}
  mk['since_at']=${s#* } mk['state']=on
  if [ -n "$u" ]; then
    mk['until_at']=${u#* }
    [ "${u%% *}" -gt "$now" ] || mk['state']=expired
  fi
}

# span NAME: "since <time>", with " until <time>" when the marker holds one.
span() {
  local -n sp=$1
  if [ -n "${sp[until]}" ]; then
    printf 'since %s until %s\n' "${sp[since_at]}" "${sp[until_at]}"
  else
    printf 'since %s\n' "${sp[since_at]}"
  fi
}
# word NAME: the word the marker's lines read for its level, on or handsoff.
word() {
  local -n wd=$1
  if [ "${wd[level]}" = handsoff ]; then echo handsoff; else echo on; fi
}

# lock_wait SECONDS: set the caller's wait to SDD_NOASK_LOCK_WAIT, or to
# SECONDS when that is unset or empty.
lock_wait() {
  wait=${SDD_NOASK_LOCK_WAIT:-$1}
  [[ $wait =~ ^[0-9]+(\.[0-9]+)?$ ]] || die 'SDD_NOASK_LOCK_WAIT is not a number of seconds'
}

# Make the state directory, take its lock, held to the end of the command,
# and narrow the directories under the lock.
take_lock() {
  local wait rc=0
  lock_wait "$LOCK_SECONDS"
  # shellcheck disable=SC2174 # 700 is for the state directory alone, not its parents
  mkdir -p -m 700 -- "$STATE" 2>/dev/null
  [ -d "$STATE" ] || die "cannot make the state directory $STATE"
  { exec 9>>"$STATE/lock"; } 2>/dev/null || die "cannot open the lock $STATE/lock"
  flock -w "$wait" 9 || rc=$?
  case $rc in
    0) ;;
    1) die 'the state directory is locked by another noask command' ;;
    *) die "cannot take the lock $STATE/lock" ;;
  esac
  narrow
}

# Narrow to the owner each of the state directory, noask.d and budgets.d that
# grants its group or others any bit; a mode with none, 500 included, is left
# as it is. Each narrowing adds its line to narrowed.
narrow() {
  local d mode
  for d in "$STATE" "$DIR" "$BUDGETS"; do
    [ -d "$d" ] || continue
    mode=$(stat -L -c %a -- "$d" 2>/dev/null) || continue
    [[ $mode =~ ^[0-7]{3,4}$ ]] || continue
    (((8#$mode & 8#077) != 0)) || continue
    chmod go-rwx -- "$d" 2>/dev/null || continue
    narrowed+=("noask: narrowed $d to the owner (it was $mode)")
  done
}

# Set generation_new for a new marker: the clock's local time to the
# nanosecond, then 8 hex characters from /dev/urandom.
new_generation() {
  local hex
  hex=$(od -An -N4 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')
  [[ $hex =~ ^[0-9a-f]{8}$ ]] || die 'cannot read /dev/urandom'
  generation_new="${stamp:0:19}.$nanos${stamp:19}-$hex"
}

# write_marker FILE KIND GENERATION SINCE UNTIL LEVEL: write the four lines to
# a temporary file beside FILE, rename it over FILE, and read FILE back into
# wm with the parser status uses; exit 1 on a failure or a mismatch.
write_marker() {
  local file=$1 kind=$2 tmp
  tmp=$(mktemp -- "${file%/*}/.noask.XXXXXX" 2>/dev/null) || die "cannot write $file"
  if ! printf 'generation=%s\nsince=%s\nuntil=%s\nlevel=%s\n' "$3" "$4" "$5" "$6" > "$tmp" 2>/dev/null ||
    ! mv -fT -- "$tmp" "$file" 2>/dev/null; then
    rm -f -- "$tmp"
    die "cannot write $file"
  fi
  read_marker "$file" "$kind" wm
  { [ "${wm[state]}" = on ] && [ "${wm[generation]}" = "$3" ] && [ "${wm[since]}" = "$4" ] &&
    [ "${wm[until]}" = "$5" ] && [ "${wm[level]}" = "$6" ]; } || die "$file does not read back as written"
}
remove_marker() {
  rm -f -- "$1" 2>/dev/null
  [ ! -e "$1" ] && [ ! -L "$1" ] || die "cannot remove $1"
}

# read_record FILE NAME: read the record FILE into the associative array
# NAME: state (absent; ok; unreadable, the file there and its read failed or
# timed out; bad, it does not parse), reason (when unreadable or bad), and
# generation, refusals, denials, continuations and spent as stored, or as an
# empty record holds them when the state is not ok. A file removed while it
# is read is absent. A record is read to one byte past RECORD_BYTES, as a
# marker is.
# shellcheck disable=SC2034 # rr is a nameref: its fields land in NAME
read_record() {
  local file=$1 raw rc reason='' state=bad
  local -a lines=()
  local -n rr=$2
  rr=(['state']=absent ['reason']='' ['generation']='' ['refusals']=0 ['denials']=0 ['continuations']=0
    ['spent']=none)
  [ -e "$file" ] || [ -L "$file" ] || return 0
  raw=$(timeout "$READ_SECONDS" head -c $((RECORD_BYTES + 1)) -- "$file" 2>/dev/null | tr '\0' '\001' && printf x)
  rc=$?
  raw=${raw%x}
  [ "$rc" -ne 0 ] || mapfile -t lines <<< "${raw%$'\n'}"
  if [ "$rc" -ne 0 ] && [ ! -e "$file" ] && [ ! -L "$file" ]; then
    return 0
  elif [ "$rc" -eq 124 ]; then
    reason='the record read timed out' state=unreadable
  elif [ "$rc" -ne 0 ]; then
    reason='the record cannot be read' state=unreadable
  elif [ "${#raw}" -gt "$RECORD_BYTES" ]; then
    reason="the record is longer than $RECORD_BYTES bytes"
  elif [ -z "$raw" ]; then
    reason='the record is empty'
  elif [[ $raw != *$'\n' ]]; then
    reason='the last line has no newline'
  elif [ "${#lines[@]}" -eq 1 ]; then
    reason='the record has 1 line, not 5'
  elif [ "${#lines[@]}" -ne 5 ]; then
    reason="the record has ${#lines[@]} lines, not 5"
  elif ! [[ ${lines[0]} =~ $RECORD_GEN_RE ]]; then
    reason='line 1 is not generation=<generation> or generation='
  elif ! [[ ${lines[1]} =~ ^refusals=$COUNTER$ ]]; then
    reason='line 2 is not refusals=<n>'
  elif ! [[ ${lines[2]} =~ ^denials=$COUNTER$ ]]; then
    reason='line 3 is not denials=<n>'
  elif ! [[ ${lines[3]} =~ ^continuations=$COUNTER$ ]]; then
    reason='line 4 is not continuations=<n>'
  elif ! [[ ${lines[4]} =~ ^spent=(none|question|permission|continuation)$ ]]; then
    reason='line 5 is not spent=none, question, permission or continuation'
  fi
  if [ -n "$reason" ]; then
    rr['state']=$state rr['reason']=$reason
    return 0
  fi
  rr['state']=ok rr['generation']=${lines[0]#generation=} rr['refusals']=${lines[1]#refusals=}
  rr['denials']=${lines[2]#denials=} rr['continuations']=${lines[3]#continuations=} rr['spent']=${lines[4]#spent=}
}

# write_record FILE GENERATION REFUSALS DENIALS CONTINUATIONS SPENT: write the
# five lines to a temporary file beside FILE, rename it over FILE, and read
# FILE back into rb with read_record; exit 1 on a failure or a mismatch.
write_record() {
  local file=$1 tmp
  tmp=$(mktemp -- "${file%/*}/.noask.XXXXXX" 2>/dev/null) || die "cannot write $file"
  if ! printf 'generation=%s\nrefusals=%s\ndenials=%s\ncontinuations=%s\nspent=%s\n' "$2" "$3" "$4" "$5" "$6" \
    > "$tmp" 2>/dev/null || ! mv -fT -- "$tmp" "$file" 2>/dev/null; then
    rm -f -- "$tmp"
    die "cannot write $file"
  fi
  read_record "$file" rb
  { [ "${rb[state]}" = ok ] && [ "${rb[generation]}" = "$2" ] && [ "${rb[refusals]}" = "$3" ] &&
    [ "${rb[denials]}" = "$4" ] && [ "${rb[continuations]}" = "$5" ] && [ "${rb[spent]}" = "$6" ]; } ||
    die "$file does not read back as written"
}

# Remove each session marker that reads expired and each leftover temporary
# file in both directories, then sweep budgets.d; a failure changes nothing
# the command reports.
sweep() {
  local f
  local -A sw=()
  rm -f -- "$STATE"/.noask.* "$DIR"/.noask.* 2>/dev/null
  for f in "$DIR"/*; do
    [[ ${f##*/} =~ $ID_RE ]] || continue
    read_marker "$f" session sw
    [ "${sw[state]}" != expired ] || rm -f -- "$f" 2>/dev/null
  done
  sweep_records
  return 0
}

# The records' sweep, after the markers' and under the records' lock taken
# without waiting: remove each file of budgets.d but .lock whose generation=
# line names no marker that reads on now, and each leftover temporary file.
# Nothing is removed (or made) with no budgets.d, while the lock is busy,
# while a marker reads unreadable, or while noask.d exists and cannot be
# listed and searched (a marker hidden in it, or read as absent because it
# cannot be looked at): a record made under such a marker carries a
# generation no reading can match, and removing it would start a spent budget
# again.
sweep_records() {
  local f first keep g
  local -a live=()
  local -A sw=()
  [ -d "$BUDGETS" ] || return 0
  if [ -d "$DIR" ] && ! { [ -r "$DIR" ] && [ -x "$DIR" ]; }; then return 0; fi
  read_marker "$GLOBAL" global sw
  case ${sw[state]} in
    unreadable) return 0 ;;
    on) live+=("generation=${sw[generation]}") ;;
  esac
  for f in "$DIR"/*; do
    [[ ${f##*/} =~ $ID_RE ]] || continue
    read_marker "$f" session sw
    case ${sw[state]} in
      unreadable) return 0 ;;
      on) live+=("generation=${sw[generation]}") ;;
    esac
  done
  { exec 8>>"$BUDGETS/.lock"; } 2>/dev/null || return 0
  flock -n 8 || return 0
  rm -f -- "$BUDGETS"/.noask.* 2>/dev/null
  for f in "$BUDGETS"/* "$BUDGETS"/.[!.]* "$BUDGETS"/..?*; do
    [ "${f##*/}" != .lock ] || continue
    first=$(timeout "$READ_SECONDS" head -c "$RECORD_BYTES" -- "$f" 2>/dev/null | tr '\0' '\001')
    first=${first%%$'\n'*}
    keep=
    for g in "${live[@]}"; do
      [ "$first" != "$g" ] || keep=1
    done
    [ -n "$keep" ] || rm -f -- "$f" 2>/dev/null
  done
  return 0
}

print_rule() {
  local text
  if [ -f "$RULE" ] && text=$(cat -- "$RULE" 2>/dev/null); then
    printf '%s\n' "$text"
  else
    printf 'noask: rule text missing at %s; sessions get the short built-in text and rule nothing\n' "$RULE"
  fi
}

# session_reading: read the global marker into gm and, with an S, S's own
# into sm; set the caller's reading to the name of the one whose state is
# S's reading, and its reading_state and reading_generation to that state
# and generation.
session_reading() {
  reading=gm
  read_marker "$GLOBAL" global gm
  if [ -n "$session" ]; then
    read_marker "$DIR/$session" session sm
    if [ "${gm[state]}" != on ] && [ "${gm[state]}" != unreadable ] && [ "${sm[state]}" != off ]; then
      reading=sm
    fi
  fi
  local -n sn=$reading
  reading_state=${sn[state]} reading_generation=${sn[generation]}
}

cmd_status() {
  local reading reading_state reading_generation line
  session_reading
  local -n r=$reading
  case ${r[state]} in
    off) line=off ;;
    on) line="on ${r[generation]}${r[until]:+ until ${r[until]}}" ;;
    expired) line="expired ${r[until]}" ;;
    unreadable) line="unreadable ${r[reason]}" ;;
  esac
  if [ -n "$session" ] && [ "${sm[state]}" = on ] && [ "${sm[level]}" = handsoff ]; then
    line+=' handsoff'
  fi
  printf '%s\n' "$line"
  [ "${r[state]}" != unreadable ] || exit 3
}

# The bare command in a session: a line for each switch that is on.
cmd_show_session() {
  local rc=0 shown_any=
  read_marker "$GLOBAL" global gm
  read_marker "$DIR/$session" session sm
  case ${gm[state]} in
    on) echo "noask: on for every session $(span gm)"; shown_any=1 ;;
    unreadable)
      echo "noask: unreadable (${gm[reason]}); sessions treat it as on; noask global off removes it"
      shown_any=1 rc=3
      ;;
  esac
  case ${sm[state]} in
    on) echo "noask: $(word sm) for this session $(span sm)"; shown_any=1 ;;
    unreadable)
      echo "noask: this session's marker is unreadable (${sm[reason]}); the session treats it as on; /noask off removes it"
      shown_any=1 rc=3
      ;;
  esac
  if [ -z "$shown_any" ]; then
    if [ "${sm[state]}" = expired ]; then
      echo "noask: off (expired ${sm[until_at]})"
    elif [ "${gm[state]}" = expired ]; then
      echo "noask: off (expired ${gm[until_at]})"
    else
      echo 'noask: off'
    fi
  fi
  exit "$rc"
}

# The bare command in a terminal: the global switch's line, then the
# sessions' own switches that are on, then those that are unreadable.
cmd_show_terminal() {
  local rc=0 f id
  local -a unreadable=()
  read_marker "$GLOBAL" global gm
  case ${gm[state]} in
    on) echo "noask: on for every session $(span gm)" ;;
    off) echo 'noask: off' ;;
    expired) echo "noask: off (expired ${gm[until_at]})" ;;
    unreadable)
      echo "noask: unreadable (${gm[reason]}); sessions treat it as on; noask global off removes it"
      rc=3
      ;;
  esac
  for f in "$DIR"/*; do
    id=${f##*/}
    [[ $id =~ $ID_RE ]] || continue
    read_marker "$f" session om
    case ${om[state]} in
      on) echo "noask: $(word om) for session $id $(span om)" ;;
      unreadable) unreadable+=("noask: session $id has an unreadable marker (${om[reason]})") rc=3 ;;
    esac
  done
  [ "${#unreadable[@]}" -eq 0 ] || printf '%s\n' "${unreadable[@]}"
  exit "$rc"
}

cmd_global_on() {
  take_lock
  read_marker "$GLOBAL" global gm
  if [ "${gm[state]}" = on ] && [ -z "$expiry" ]; then
    echo "noask: already on for every session $(span gm); nothing changed"
  elif [ "${gm[state]}" = on ]; then
    write_marker "$GLOBAL" global "${gm[generation]}" "${gm[since]}" "$until_new" noask
    echo "noask: on for every session $(span wm) (expiry renewed)"
    echo "marker: $GLOBAL"
  else
    new_generation
    write_marker "$GLOBAL" global "$generation_new" "$stamp" "$until_new" noask
    echo "noask: on for every session $(span wm)"
    echo "marker: $GLOBAL"
    echo
    print_rule
  fi
  sweep
}

cmd_session_on() {
  local target=$DIR/$session also='' level=noask note='' until
  take_lock
  read_marker "$target" session sm
  read_marker "$GLOBAL" global gm
  case ${gm[state]} in
    on) also="; also on for every session $(span gm)" ;;
    unreadable)
      also="; the global marker is unreadable (${gm[reason]}) and holds every session under noask; noask global off removes it"
      ;;
  esac
  [ -z "$handsoff" ] || level=handsoff
  if [ "${sm[state]}" = on ]; then
    [ "${sm[level]}" != handsoff ] || level=handsoff
    if [ "$level" = "${sm[level]}" ] && [ -z "$expiry" ]; then
      echo "noask: already $(word sm) for this session $(span sm); nothing changed$also"
    else
      if [ "$level" != "${sm[level]}" ]; then note=' (level raised'; else note=' (expiry'; fi
      if [ -n "$expiry" ]; then
        until=$until_new
        if [ "$level" != "${sm[level]}" ]; then note+=', expiry renewed)'; else note+=' renewed)'; fi
      else
        until=${sm[until]}
        note+=')'
      fi
      write_marker "$target" session "${sm[generation]}" "${sm[since]}" "$until" "$level"
      echo "noask: $(word wm) for this session $(span wm)$note$also"
      echo "marker: $target"
    fi
  else
    until=$until_new
    if [ -z "$expiry" ]; then
      until=$(iso_of $((now + SESSION_HOURS * 3600))) || die 'cannot read the clock'
      note=" ($SESSION_HOURS hours by default; /noask on <expiry> sets another)"
    fi
    mkdir -m 700 -- "$DIR" 2>/dev/null # its parent, the state directory, take_lock made
    [ -d "$DIR" ] || die "cannot make $DIR"
    new_generation
    write_marker "$target" session "$generation_new" "$stamp" "$until" "$level"
    echo "noask: $(word wm) for this session $(span wm)$note$also"
    echo "marker: $target"
    echo
    print_rule
  fi
  sweep
}

cmd_global_off() {
  local line f n=0
  take_lock
  read_marker "$GLOBAL" global gm
  case ${gm[state]} in
    off) line='noask: already off for every session' ;;
    on) remove_marker "$GLOBAL"; line='noask: off for every session' ;;
    expired)
      remove_marker "$GLOBAL"
      line="noask: off for every session (expired ${gm[until_at]}; marker removed)"
      ;;
    unreadable) remove_marker "$GLOBAL"; line='noask: off for every session (unreadable marker removed)' ;;
  esac
  if [ -n "$session" ]; then
    read_marker "$DIR/$session" session sm
    case ${sm[state]} in
      on) line+="; still $(word sm) for this session until ${sm[until_at]}; /noask off ends that" ;;
      unreadable)
        line+="; this session's marker is unreadable (${sm[reason]}) and treated as on; /noask off removes it"
        ;;
    esac
  else
    for f in "$DIR"/*; do
      [[ ${f##*/} =~ $ID_RE ]] || continue
      read_marker "$f" session om
      [ "${om[state]}" != on ] && [ "${om[state]}" != unreadable ] || n=$((n + 1))
    done
    [ "$n" -eq 0 ] || line+="; sessions still on by their own switch: $n (noask lists them)"
  fi
  printf '%s\n' "$line"
  sweep
}

cmd_session_off() {
  local target=$DIR/$session line
  take_lock
  read_marker "$target" session sm
  case ${sm[state]} in
    off) line='noask: already off for this session' ;;
    on) remove_marker "$target"; line='noask: off for this session' ;;
    expired)
      remove_marker "$target"
      line="noask: off for this session (expired ${sm[until_at]}; marker removed)"
      ;;
    unreadable) remove_marker "$target"; line='noask: off for this session (unreadable marker removed)' ;;
  esac
  read_marker "$GLOBAL" global gm
  case ${gm[state]} in
    on) line+="; still on for every session $(span gm); noask global off ends that" ;;
    unreadable)
      line+="; still treated as on for every session: unreadable marker (${gm[reason]}); noask global off removes it"
      ;;
  esac
  printf '%s\n' "$line"
  sweep
}

# count: charge count_word to the record of S, or of S's subagent, under S's
# reading, as the header says.
cmd_count() {
  local file=$BUDGETS/$session${agent:+.$agent} reading reading_state reading_generation wait rc=0 counter='' spent=''
  session_reading
  case $reading_state in off | expired) echo off; return ;; esac
  lock_wait "$COUNT_LOCK_SECONDS"
  mkdir -m 700 -- "$BUDGETS" 2>/dev/null # the state directory exists: the marker just read is in it
  [ -d "$BUDGETS" ] || die "cannot make $BUDGETS"
  { exec 8>>"$BUDGETS/.lock"; } 2>/dev/null || die "cannot open the lock $BUDGETS/.lock"
  flock -w "$wait" 8 || rc=$?
  case $rc in
    0) ;;
    1) die 'the records are locked by another noask command' ;;
    *) die "cannot take the lock $BUDGETS/.lock" ;;
  esac
  session_reading
  case $reading_state in off | expired) echo off; return ;; esac
  read_record "$file" rec
  [ "${rec[state]}" != unreadable ] || die "cannot read $file (${rec[reason]})"
  local note=${rec[reason]} # set when the record did not parse; said once the count has succeeded
  if [ "$reading_state" = on ] && [ "${rec[generation]}" != "$reading_generation" ]; then
    rec=(['generation']=$reading_generation ['refusals']=0 ['denials']=0 ['continuations']=0 ['spent']=none)
  fi
  case $count_word in
    question) counter=refusals spent=question ;;
    denial) counter=denials spent=permission ;;
    continuation) counter=continuations spent=continuation ;;
    reset) if [ "${rec[spent]}" = none ]; then rec['refusals']=0 rec['denials']=0 rec['continuations']=0; fi ;;
  esac
  if [ -n "$counter" ] && [ "${rec[spent]}" = none ]; then
    rec[$counter]=$((rec[$counter] + 1))
    [ "${rec[$counter]}" -lt "$budget" ] || rec['spent']=$spent
  fi
  if [ "$count_word" != read ]; then
    write_record "$file" "${rec[generation]}" "${rec[refusals]}" "${rec[denials]}" "${rec[continuations]}" \
      "${rec[spent]}"
  fi
  [ -z "$note" ] || printf 'noask: the record %s did not parse (%s); started again\n' "$file" "$note" >&2
  printf 'counted %s %s %s %s\n' "${rec[spent]}" "${rec[refusals]}" "${rec[denials]}" "${rec[continuations]}"
}

case $action/$scope in
  status/) cmd_status ;;
  count/) cmd_count ;;
  show/) if [ -n "$session" ]; then cmd_show_session; else cmd_show_terminal; fi ;;
  on/global) cmd_global_on ;;
  on/session) cmd_session_on ;;
  off/global) cmd_global_off ;;
  off/session) cmd_session_off ;;
esac
[ "${#narrowed[@]}" -eq 0 ] || printf '%s\n' "${narrowed[@]}"
exit 0
