#!/usr/bin/env bash
# noask: the switch under which an agent stops asking the owner and rules for
# itself, by the rule text in scripts/noask-rule.md. This command is the only
# writer of the switch's markers and of the sessions' records; the plugin's
# module and hooks read the markers, never a record, and change a record only
# through count. It is reached through links from a terminal's PATH, so it
# finds the plugin root from its own path with every symbolic link resolved.
#
# Usage:
#   noask [--session <id>] [status]
#   noask --session <id> on [handsoff] [<expiry>]
#   noask --session <id> off
#   noask [--session <id>] global on [<expiry>]
#   noask [--session <id>] global off
#   noask --session <id> [--agent <agent id>] count question|denial|continuation <budget>
#   noask --session <id> [--agent <agent id>] count reset
#   noask --session <id> [--agent <agent id>] count read
#   noask hook session-start|permission|elicitation|stop
#   noask [--session <id>] start-line
#   <expiry> is <n>h or <n>m (<n> from 1 to 99999), or `until HH:MM`: the
#   next such local time strictly after now (in an hour a clock change
#   repeats, the earlier of its two passes still ahead), refused (exit 2)
#   when a clock change skips it on that day. The marker stores the absolute
#   time. <budget> is 1 to 99999 (^[1-9][0-9]{0,4}$); an <agent id> matches
#   ^[A-Za-z0-9_-]{1,64}$. No person types count: the plugin's hooks call it.
#   No person types hook or start-line either: the plugin's hooks call hook
#   with the hook's JSON input on standard input, and its module calls
#   start-line.
#
# The session S the command acts for is the --session value, which comes
# first, must match ^[A-Za-z0-9_-]{1,64}$ and must be none of the command's
# own words (RESERVED; `--session on` is a wrong argument, whatever
# follows); else, for status and the bare command only,
# CLAUDE_CODE_SESSION_ID when it has that form; else none. `on` and `off`
# without --session are refused: a session's switch is typed in the session
# (/noask on), and `noask global on` switches every session. hook takes no
# --session: its S is the input's session_id, and a subagent's id the
# input's agent_id, each taken only when it is a JSON string of the id's form
# (the session's none of RESERVED); neither hook nor start-line ever takes
# CLAUDE_CODE_SESSION_ID.
#
# The platform is Linux with bash 5, GNU coreutils and flock; for coreutils
# the command tests the one thing it needs that BSD's date lacks, a date
# that reads -d @<epoch> (GNU's and uutils' do). Off the platform no marker
# can exist: status, with or without --session, prints off and the bare
# command "noask: off", exit 0; hook and start-line print nothing, exit 0;
# every other form exits 1 with a line that says so and writes nothing. A
# missing flock alone does not take hook and start-line off the platform: an
# entry reads the markers and answers, and its count fails.
#
# Markers: the global one is $HOME/.local/state/sdd/noask, a session's is
# $HOME/.local/state/sdd/noask.d/<id>. Each holds four lines:
#   generation=<local ISO-8601 time, nine fractional digits, numeric offset>-<8 hex>
#   since=<local ISO-8601 time to the second, numeric offset>
#   until=<the same form, or empty; never empty in a session's marker>
#   level=<noask or handsoff; always noask in the global marker>
# A numeric offset is [+-]HH:MM from 00:00 to 14:00 (OFFSET_RE): no real
# offset is past 14 hours, and the plugin's module refuses a minute past 59,
# which date carries into the hour (+04:60 as +05:00).
# A reading of one marker is off (no file), on, expired (an until not after
# now; read as off) or unreadable (the file exists and cannot be read within
# 2 seconds, is longer than 4096 bytes, or does not parse). S's reading is
# the global marker's when that is on or unreadable, else S's own when that
# is not off, else the global marker's; with no S, the global marker's
# alone. With HOME unset or empty every reading is off.
#
# Records: a session's is $HOME/.local/state/sdd/budgets.d/<id>, a
# subagent's budgets.d/<id>.<agent id>. Each holds five lines:
#   generation=<the generation of the marker S reads, or empty>
#   refusals=<n>
#   denials=<n>
#   continuations=<n>
#   spent=<none, question, permission or continuation>
# <n> is 0 to 99999. A record that is longer than 4096 bytes or does not
# parse is started again as an empty one by a count that writes, and read as
# an empty one and left as it is by read; each says so in a line on standard
# error. A record that exists and cannot be read within 2 seconds is
# neither: the count fails (exit 1) and leaves it as it is, since starting
# it again would clear a spent budget inside its generation.
#
# count charges S's record, or its subagent's. When S reads off or expired it
# prints off and makes nothing. Otherwise it makes budgets.d (mode 700), takes
# its lock budgets.d/.lock (flock, 2 seconds; never the switch's lock), reads
# S again under it and acts on that second reading: off or expired prints off
# and writes no record; on, with no record or one of another generation,
# starts an empty record under the reading's generation; on under the
# record's generation, or unreadable, keeps the record and its generation (an
# empty one for a new record). Then question, denial and continuation add one
# to refusals, denials and continuations while spent is none, and set spent
# to question, permission and continuation when that counter reaches
# <budget>; reset zeroes the three counters while spent is none; read writes
# nothing. A record is written as a marker is (a temporary .noask.* file
# renamed over it, then read back), and count prints the record as it then
# stands: "counted <spent> <refusals> <denials> <continuations>".
#
# Output. status: one line, off, on <generation>[ until <until>], expired
# <until> or unreadable <reason>; the on and unreadable lines end in
# " handsoff" when S's own marker reads on at that level. The bare command
# with an S: a line for each switch that is on, the global one first, else
# "noask: off" or "noask: off (expired <time>)"; without an S (a terminal):
# the global switch's line, then one line per session marker that reads on,
# then one per session marker that is unreadable. A switching command prints
# what it did and, when it wrote a marker, the marker's path; a new `on` adds
# an empty line and the rule text; a session's `on` beside an unreadable
# global marker ends its first line saying that marker holds every session.
# Last come the narrowing lines, "noask: narrowed <path> to the owner (it
# was <octal mode>)". <time> is HH:MM on today's local date, else
# YYYY-MM-DD HH:MM.
#
# A switching command checks its arguments, makes the state directory (mode
# 700, as it makes noask.d; it never makes budgets.d), takes the lock
# <state directory>/lock (flock, 5 seconds), narrows to the owner each of
# the state directory, noask.d and budgets.d that grants its group or others
# any bit (chmod go-rwx; a mode with no such bit, 500 included, is left as
# it is), reads its target marker, switches it (a write goes to a temporary
# .noask.* file renamed over the marker, then is read back with the parser
# status uses), prints its lines, and then sweeps: it removes each session
# marker that reads expired and each leftover .noask.* file in both
# directories; then, when budgets.d exists and its lock is free (flock -n,
# taken after the state directory's), each file of budgets.d but .lock whose
# generation= line names no marker that reads on, the markers read as they
# stand after the switch, and the .noask.* files there. It removes no record
# while the global marker or a session's reads unreadable, or while noask.d
# exists and cannot be listed and searched: a record made under such a marker
# carries a generation no reading can match, and removing it would start a
# spent budget again. A failed sweep changes neither the output nor the exit.
# status and the bare command take no lock, change no mode and write
# nothing.
#
# The hook entries. hook <event> reads its input once (to 4 MiB, within 4
# seconds) and takes S's reading; an input that is not exactly one JSON
# object with a usable session_id, or a machine without jq (which the
# entries alone call), gives the reading of a session with no id: the global
# marker's when that is on or unreadable; else unreadable when noask.d exists
# and cannot be listed or searched, or when a marker in it reads on or
# unreadable (the look stops at the first); else the global marker's. Under
# a reading of off or expired an entry prints nothing, makes no file and takes
# no lock. Otherwise it answers once, one line of JSON on standard output in
# the form its event takes, every text in it through json_string; a trap
# answers the noask side when it would end without an answer. An entry
# exits 0 whatever happened short of a kill, and prints nothing without
# HOME or a clock. session-start answers with the start line as its message
# and the rule text and where the apply skill's noask reference is as its
# context. permission and elicitation are inert also while the
# permissionHook option is exactly false (CLAUDE_PLUGIN_OPTION_PERMISSIONHOOK);
# otherwise each counts a denial first, against the denialBudget option
# (CLAUDE_PLUGIN_OPTION_DENIALBUDGET, 10 when absent or not 1 to 99999), on
# S's record or, with an agent_id, on its subagent's (it counts nothing
# without a usable session id or with an agent id of another form); then it
# answers.
# permission denies, with PERMISSION_TEXT for the main session and
# SUBAGENT_TEXT for a subagent, the ending text and SUBAGENT_SPENT_TEXT once
# the budget is spent, and after it the count's failure or note and an
# unreadable reading's reason; elicitation declines, whatever the count
# gave. stop answers nothing here.
# start-line prints the start line of S (--session), or of a session with no
# id, and nothing when that reading is off or expired: one line, and the notes
# that say jq is not on PATH or the rule file could not be read; it reads no
# input, takes no lock, writes nothing and exits 0, an unreadable marker
# included.
#
# Exit codes: 0 done (a switch made, whatever the marker held before; a
# count's off or counted line; a hook entry or start-line, whatever they
# met); 1 the state directory, the lock, or a
# marker's write, read-back or removal failed, or a count could not make
# budgets.d, take its lock, or read, write or read back its record, or a
# switching command found HOME unset or empty, or any form but status, the
# bare command, hook and start-line ran off the platform; 2 a wrong argument
# on the platform, nothing touched; 3 status or the bare command met an
# unreadable marker.
#
# Test seams: SDD_NOASK_NOW=<epoch seconds> replaces the clock;
# SDD_NOASK_LOCK_WAIT=<seconds> replaces the lock's 5 and the count's 2. Either
# set to the empty string reads as unset.
set -uo pipefail
shopt -s nullglob
export LC_ALL=C

readonly SESSION_HOURS=8 # a session's switch given no expiry ends this many hours after since
readonly LOCK_SECONDS=5  # how long a switching command waits for the lock
readonly COUNT_LOCK_SECONDS=2 # how long a count waits for the records' lock
readonly READ_SECONDS=2  # a marker or record read that takes longer reads unreadable
readonly MARKER_BYTES=4096 # a longer marker reads unreadable
readonly RECORD_BYTES=4096 # a longer record does not parse
readonly INPUT_BYTES=4194304 # a hook's input longer than this, 4 MiB, is no usable input
readonly RULE_BYTES=65536    # a longer rule file reads as unreadable, as one that cannot be read
readonly ID_RE='^[A-Za-z0-9_-]{1,64}$'
# The id's form as jq tests it, on the whole decoded string: jq's ^ and $ also match at a line break inside it.
readonly JQ_ID_RE='\A[A-Za-z0-9_-]{1,64}\z'
# The command's own words, never a session id.
readonly RESERVED='status on off global handsoff until count reset read question denial continuation'
readonly OFFSET_RE='[+-]((0[0-9]|1[0-3]):[0-5][0-9]|14:00)' # 00:00 to 14:00, either sign
readonly TIME_RE='[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}'"$OFFSET_RE"
readonly GENERATION='[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{9}'"$OFFSET_RE"'-[0-9a-f]{8}'
readonly GEN_RE="^generation=$GENERATION\$"
readonly SINCE_RE="^since=$TIME_RE\$"
readonly UNTIL_RE="^until=($TIME_RE)?\$"
readonly RECORD_GEN_RE="^generation=($GENERATION)?\$" # a record's generation may be empty
readonly COUNTER='(0|[1-9][0-9]{0,4})'                 # a record's counter, 0 to 99999

usage() {
  echo 'usage: noask [--session <id>] [status | on [handsoff] [<expiry>] | off | global on [<expiry>] | global off], <expiry> being <n>h, <n>m or until HH:MM;' \
    'noask --session <id> [--agent <agent id>] count question|denial|continuation <budget> | count reset | count read;' \
    'noask hook session-start|permission|elicitation|stop; noask [--session <id>] start-line' >&2
  exit 2
}
# Print the failure and exit 1; died keeps the message, which a hook entry's
# failure answer names.
died=''
die() {
  died=$1
  printf 'noask: %s\n' "$1" >&2
  exit 1
}
# is_session_id WORD: WORD matches ID_RE and is none of the RESERVED words.
is_session_id() { [[ $1 =~ $ID_RE ]] && [[ " $RESERVED " != *" $1 "* ]]; }

# hook <event> and [--session <id>] start-line, told apart before the
# platform test: off the platform, without HOME and without a clock they
# print nothing and exit 0 (quiet), where the other forms fail. A hook
# entry's first step is the plain trap: a signal before its guard ends it
# with nothing printed and status 0.
quiet=''
case $#/${1-} in
  2/hook)
    case $2 in
      session-start | permission | elicitation | stop) quiet=1; trap 'exit 0' TERM INT HUP ;;
    esac
    ;;
  1/start-line) quiet=1 ;;
  3/--session) if [ "$3" = start-line ] && is_session_id "$2"; then quiet=1; fi ;;
esac

# The platform, tested before anything that needs it and with nothing newer
# than bash 3.2 reads: bash 5, flock, and a date that reads -d @<epoch>.
# Off it no marker can exist, so status and the bare command read off, hook
# and start-line print nothing, and every other form is refused. hook and
# start-line need no flock to read.
if [ "${BASH_VERSINFO[0]}" -lt 5 ] || [ "$(date -d @0 +%s 2> /dev/null)" != 0 ] ||
  { [ -z "$quiet" ] && ! command -v flock > /dev/null 2>&1; }; then
  [ -z "$quiet" ] || exit 0
  if [ "${1-}" = --session ] && [ $# -ge 2 ] && [ "$2" != --session ] && is_session_id "$2"; then shift 2; fi
  case $#/${1-} in
    0/) echo 'noask: off' ;;
    1/status) echo off ;;
    *) die 'this command needs Linux with bash 5, GNU coreutils and flock; noask is not available here' ;;
  esac
  exit 0
fi

ROOT=$(dirname -- "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")") # the plugin root
RULE=$ROOT/scripts/noask-rule.md
readonly ROOT RULE
# The rule text a hook entry gives when the rule file cannot be read: it rules nothing and blocks every choice
# (FALLBACK_RULE of hooks/text.ts).
# shellcheck disable=SC2016 # its backquotes are the text's, not substitutions
readonly FALLBACK_RULE='noask is on: nobody answers until it is off, and its rule file could not be read, so rule nothing: print `blocked: <what>` for every choice you would ask about, do not commit on a default branch, do not push, do not switch noask, and end every turn on `noask: waiting: <what>`, `noask: done` or `noask: blocked: <why>` as its last line'
# The permission entry's denial for the main session, Intervention 2's words, <the action> standing as it is.
# shellcheck disable=SC2016 # its backquotes are the text's, not substitutions
readonly PERMISSION_TEXT='noask is on: this action needs the owner; print `blocked: <the action>` and continue with the next independent item'
# A subagent's denial, under its budget and once that is spent (SUBAGENT_TEXT and SUBAGENT_SPENT_TEXT of hooks/text.ts).
readonly SUBAGENT_TEXT="noask is on: this action needs the owner and is denied; follow your role's rule for a denied tool"
readonly SUBAGENT_SPENT_TEXT="noask is on: this action needs the owner and is denied, and this agent's noask budget is spent; return under your role's rule for a denied tool"

# Parse the arguments of an `on` after the word on: [handsoff] [<expiry>].
parse_on() {
  if [ "${1-}" = handsoff ]; then
    if [ "$scope" = global ]; then
      echo "noask: handsoff is a session's level; type /noask on handsoff in the session that may publish" >&2
      exit 2
    fi
    handsoff=1
    shift
  fi
  case $# in
    0) ;;
    1) [[ $1 =~ ^[1-9][0-9]{0,4}[hm]$ ]] || usage; expiry=$1 ;;
    2) { [ "$1" = until ] && [[ $2 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; } || usage; expiry="until $2" ;;
    *) usage ;;
  esac
}

session='' given='' action='' scope='' handsoff='' expiry='' agent='' count_word='' budget='' event=''
if [ "${1-}" = --session ]; then
  { [ $# -ge 2 ] && [ "$2" != --session ] && is_session_id "$2"; } || usage
  session=$2 given=1
  shift 2
  if [ "${1-}" = --agent ]; then
    { [ $# -ge 3 ] && [ "$2" != --agent ] && [[ $2 =~ $ID_RE ]] && [ "$3" = count ]; } || usage
    agent=$2
    shift 2
  fi
fi
case ${1-} in
  count)
    [ -n "$given" ] || usage
    case $#/${2-} in
      3/question | 3/denial | 3/continuation) [[ $3 =~ ^[1-9][0-9]{0,4}$ ]] || usage; budget=$3 ;;
      2/reset | 2/read) ;;
      *) usage ;;
    esac
    action=count count_word=$2
    ;;
  hook) { [ -z "$given" ] && [ -n "$quiet" ]; } || usage; action=hook event=$2 ;;
  start-line) [ $# -eq 1 ] || usage; action=start-line ;;
  '') action=show ;;
  status) [ $# -eq 1 ] || usage; action=status ;;
  on | off)
    if [ -z "$given" ]; then
      echo "noask: a session's switch is typed in the session as /noask on; noask global on switches every session" >&2
      exit 2
    fi
    action=$1 scope=session
    shift
    if [ "$action" = on ]; then parse_on "$@"; elif [ $# -ne 0 ]; then usage; fi
    ;;
  global)
    case ${2-} in
      on) action=on scope=global; shift 2; parse_on "$@" ;;
      off) [ $# -eq 2 ] || usage; action=off scope=global ;;
      *) usage ;;
    esac
    ;;
  *) usage ;;
esac
if [ -z "$given" ] && { [ "$action" = status ] || [ "$action" = show ]; } &&
  is_session_id "${CLAUDE_CODE_SESSION_ID:-}"; then
  session=$CLAUDE_CODE_SESSION_ID
fi

# no_clock MESSAGE: the clock cannot be read; hook and start-line end with
# nothing printed and status 0, every other form fails with MESSAGE.
no_clock() {
  [ -z "$quiet" ] || exit 0
  die "$1"
}
# The clock, read once: now (epoch seconds), today and the local HH:MM, and
# the local time with its offset (stamp) and nanoseconds for a new marker.
if [ -n "${SDD_NOASK_NOW:-}" ]; then
  [[ $SDD_NOASK_NOW =~ ^[0-9]+$ ]] || no_clock 'SDD_NOASK_NOW is not epoch seconds'
  clock=$(date -d "@$SDD_NOASK_NOW" +'%s %F %H:%M %Y-%m-%dT%H:%M:%S%:z %N')
else
  clock=$(date +'%s %F %H:%M %Y-%m-%dT%H:%M:%S%:z %N')
fi || no_clock 'cannot read the clock'
[[ $clock =~ ^[0-9]+\ [0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}\ [0-9T:+-]{25}\ [0-9]{9}$ ]] ||
  no_clock 'cannot read the clock'
read -r now today hm_now stamp nanos <<< "$clock"

iso_of() { date -d "@$1" +%Y-%m-%dT%H:%M:%S%:z; } # EPOCH as a marker's time
# at_local DAY HH:MM: the epochs, ascending, that date shows as HH:MM on DAY:
# one, or two when a clock change repeats that hour. date answers either
# pass (uutils' the first, GNU's the second), so the hour before and the
# hour after its answer are looked at too. Fails when the clock skips HH:MM
# that day (date refuses it, or answers another time of day).
at_local() {
  local out t e
  out=$(date -d "$1 $2:00" +'%s %F %H:%M' 2>/dev/null) || return 1
  [ "${out#* }" = "$1 $2" ] || return 1
  t=${out%% *}
  for e in $((t - 3600)) "$t" $((t + 3600)); do
    [ "$e" = "$t" ] || [ "$(date -d "@$e" +'%F %H:%M' 2>/dev/null)" = "$1 $2" ] || continue
    printf '%s\n' "$e"
  done
}
# Set until_epoch to the next local HH:MM strictly after now: today's
# earliest pass after now, else tomorrow's first; exit 2 when that day skips
# it.
next_local() {
  local hm=$1 t passes noon tomorrow
  if passes=$(at_local "$today" "$hm"); then
    for t in $passes; do
      if [ "$t" -gt "$now" ]; then until_epoch=$t; return; fi
    done
  elif [ $((10#${hm%:*} * 60 + 10#${hm#*:})) -gt $((10#${hm_now%:*} * 60 + 10#${hm_now#*:})) ]; then
    printf 'noask: %s does not exist on %s (a clock change skips it)\n' "$hm" "$today" >&2
    exit 2
  fi
  noon=$(date -d "$today 12:00:00" +%s) || die 'cannot read the clock'
  tomorrow=$(date -d "@$((noon + 86400))" +%F) || die 'cannot read the clock'
  if ! passes=$(at_local "$tomorrow" "$hm"); then
    printf 'noask: %s does not exist on %s (a clock change skips it)\n' "$hm" "$tomorrow" >&2
    exit 2
  fi
  until_epoch=${passes%%$'\n'*}
}

# The expiry as a marker's until (until_new), empty when none was given.
until_new=
if [ -n "$expiry" ]; then
  case $expiry in
    until\ *) next_local "${expiry#until }" ;;
    *h) until_epoch=$((now + ${expiry%h} * 3600)) ;;
    *m) until_epoch=$((now + ${expiry%m} * 60)) ;;
  esac
  until_new=$(iso_of "$until_epoch") || die 'cannot read the clock'
fi

if [ -z "${HOME:-}" ]; then
  [ -z "$quiet" ] || exit 0
  case $action in
    status | count) echo off ;;
    show) echo 'noask: off' ;;
    *) die 'HOME is not set' ;;
  esac
  exit 0
fi
STATE=$HOME/.local/state/sdd
GLOBAL=$STATE/noask
DIR=$STATE/noask.d
BUDGETS=$STATE/budgets.d
declare -A gm=() sm=() om=() wm=() rec=() rb=() # markers read and read back; a record and its read-back
narrowed=() # the narrowing lines, printed after a switching command's own

# shown TIME: "<epoch> <time>" for a marker's TIME, <time> being HH:MM on
# today's local date, else YYYY-MM-DD HH:MM; fails when date cannot read it.
shown() {
  local out
  out=$(date -d "$1" +'%s %F %H:%M' 2>/dev/null) || return 1
  [[ $out =~ ^(-?[0-9]+)\ ([0-9-]+)\ ([0-9:]+)$ ]] || return 1
  if [ "${BASH_REMATCH[2]}" = "$today" ]; then
    printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[3]}"
  else
    printf '%s\n' "$out"
  fi
}

# read_marker FILE KIND NAME: read the marker FILE, global or session by KIND,
# into the associative array NAME: state (off, on, expired or unreadable),
# reason (when unreadable), generation, since, until and level as stored,
# and since_at and until_at as <time>. A file removed while it is read
# reads off. A marker is read to one byte past MARKER_BYTES, so one of
# exactly that size is still parsed. No reason ends in the word handsoff: a
# status line that ends in it lets a session publish.
# shellcheck disable=SC2034 # mk is a nameref: its fields land in NAME
read_marker() {
  local file=$1 kind=$2 raw rc reason='' s='' u=''
  local -a lines=()
  local -n mk=$3
  mk=(['state']=off ['reason']='' ['generation']='' ['since']='' ['until']='' ['level']='' ['since_at']=''
    ['until_at']='')
  [ -e "$file" ] || [ -L "$file" ] || return 0
  raw=$(timeout "$READ_SECONDS" head -c $((MARKER_BYTES + 1)) -- "$file" 2>/dev/null | tr '\0' '\001' && printf x)
  rc=$?
  raw=${raw%x}
  [ "$rc" -ne 0 ] || mapfile -t lines <<< "${raw%$'\n'}"
  if [ "$rc" -ne 0 ] && [ ! -e "$file" ] && [ ! -L "$file" ]; then
    return 0
  elif [ "$rc" -eq 124 ]; then
    reason='marker read timed out'
  elif [ "$rc" -ne 0 ]; then
    reason='the marker cannot be read'
  elif [ "${#raw}" -gt "$MARKER_BYTES" ]; then
    reason="the marker is longer than $MARKER_BYTES bytes"
  elif [ -z "$raw" ]; then
    reason='the marker is empty'
  elif [[ $raw != *$'\n' ]]; then
    reason='the last line has no newline'
  elif [ "${#lines[@]}" -eq 1 ]; then
    reason='the marker has 1 line, not 4'
  elif [ "${#lines[@]}" -ne 4 ]; then
    reason="the marker has ${#lines[@]} lines, not 4"
  elif ! [[ ${lines[0]} =~ $GEN_RE ]]; then
    reason='line 1 is not generation=<time>-<8 hex>'
  elif ! [[ ${lines[1]} =~ $SINCE_RE ]] || ! s=$(shown "${lines[1]#since=}"); then
    reason='line 2 is not since=<time>'
  elif ! [[ ${lines[2]} =~ $UNTIL_RE ]] || { [ "${lines[2]}" != until= ] && ! u=$(shown "${lines[2]#until=}"); }; then
    reason='line 3 is not until=<time> or until='
  elif ! [[ ${lines[3]} =~ ^level=(noask|handsoff)$ ]]; then
    reason='line 4 is not level=handsoff or level=noask'
  elif [ "$kind" = global ] && [ "${lines[3]}" = level=handsoff ]; then
    reason="level=handsoff in the global marker, which only a session's marker holds"
  elif [ "$kind" = session ] && [ "${lines[2]}" = until= ]; then
    reason="a session's marker without an until"
  fi
  if [ -n "$reason" ]; then
    mk['state']=unreadable mk['reason']=$reason
    return 0
  fi
  mk['generation']=${lines[0]#generation=} mk['since']=${lines[1]#since=}
  mk['until']=${lines[2]#until=} mk['level']=${lines[3]#level=}
  mk['since_at']=${s#* } mk['state']=on
  if [ -n "$u" ]; then
    mk['until_at']=${u#* }
    [ "${u%% *}" -gt "$now" ] || mk['state']=expired
  fi
}

# span NAME: "since <time>", with " until <time>" when the marker holds one.
span() {
  local -n sp=$1
  if [ -n "${sp[until]}" ]; then
    printf 'since %s until %s\n' "${sp[since_at]}" "${sp[until_at]}"
  else
    printf 'since %s\n' "${sp[since_at]}"
  fi
}
# word NAME: the word the marker's lines read for its level, on or handsoff.
word() {
  local -n wd=$1
  if [ "${wd[level]}" = handsoff ]; then echo handsoff; else echo on; fi
}

# lock_wait SECONDS: set the caller's wait to SDD_NOASK_LOCK_WAIT, or to
# SECONDS when that is unset or empty.
lock_wait() {
  wait=${SDD_NOASK_LOCK_WAIT:-$1}
  [[ $wait =~ ^[0-9]+(\.[0-9]+)?$ ]] || die 'SDD_NOASK_LOCK_WAIT is not a number of seconds'
}

# Make the state directory, take its lock, held to the end of the command,
# and narrow the directories under the lock.
take_lock() {
  local wait rc=0
  lock_wait "$LOCK_SECONDS"
  # shellcheck disable=SC2174 # 700 is for the state directory alone, not its parents
  mkdir -p -m 700 -- "$STATE" 2>/dev/null
  [ -d "$STATE" ] || die "cannot make the state directory $STATE"
  { exec 9>>"$STATE/lock"; } 2>/dev/null || die "cannot open the lock $STATE/lock"
  flock -w "$wait" 9 || rc=$?
  case $rc in
    0) ;;
    1) die 'the state directory is locked by another noask command' ;;
    *) die "cannot take the lock $STATE/lock" ;;
  esac
  narrow
}

# Narrow to the owner each of the state directory, noask.d and budgets.d that
# grants its group or others any bit; a mode with none, 500 included, is left
# as it is. Each narrowing adds its line to narrowed.
narrow() {
  local d mode
  for d in "$STATE" "$DIR" "$BUDGETS"; do
    [ -d "$d" ] || continue
    mode=$(stat -L -c %a -- "$d" 2>/dev/null) || continue
    [[ $mode =~ ^[0-7]{3,4}$ ]] || continue
    (((8#$mode & 8#077) != 0)) || continue
    chmod go-rwx -- "$d" 2>/dev/null || continue
    narrowed+=("noask: narrowed $d to the owner (it was $mode)")
  done
}

# Set generation_new for a new marker: the clock's local time to the
# nanosecond, then 8 hex characters from /dev/urandom.
new_generation() {
  local hex
  hex=$(od -An -N4 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')
  [[ $hex =~ ^[0-9a-f]{8}$ ]] || die 'cannot read /dev/urandom'
  generation_new="${stamp:0:19}.$nanos${stamp:19}-$hex"
}

# write_marker FILE KIND GENERATION SINCE UNTIL LEVEL: write the four lines to
# a temporary file beside FILE, rename it over FILE, and read FILE back into
# wm with the parser status uses; exit 1 on a failure or a mismatch.
write_marker() {
  local file=$1 kind=$2 tmp
  tmp=$(mktemp -- "${file%/*}/.noask.XXXXXX" 2>/dev/null) || die "cannot write $file"
  if ! printf 'generation=%s\nsince=%s\nuntil=%s\nlevel=%s\n' "$3" "$4" "$5" "$6" > "$tmp" 2>/dev/null ||
    ! mv -fT -- "$tmp" "$file" 2>/dev/null; then
    rm -f -- "$tmp"
    die "cannot write $file"
  fi
  read_marker "$file" "$kind" wm
  { [ "${wm[state]}" = on ] && [ "${wm[generation]}" = "$3" ] && [ "${wm[since]}" = "$4" ] &&
    [ "${wm[until]}" = "$5" ] && [ "${wm[level]}" = "$6" ]; } || die "$file does not read back as written"
}
remove_marker() {
  rm -f -- "$1" 2>/dev/null
  [ ! -e "$1" ] && [ ! -L "$1" ] || die "cannot remove $1"
}

# read_record FILE NAME: read the record FILE into the associative array
# NAME: state (absent; ok; unreadable, the file there and its read failed or
# timed out; bad, it does not parse), reason (when unreadable or bad), and
# generation, refusals, denials, continuations and spent as stored, or as an
# empty record holds them when the state is not ok. A file removed while it
# is read is absent. A record is read to one byte past RECORD_BYTES, as a
# marker is.
# shellcheck disable=SC2034 # rr is a nameref: its fields land in NAME
read_record() {
  local file=$1 raw rc reason='' state=bad
  local -a lines=()
  local -n rr=$2
  rr=(['state']=absent ['reason']='' ['generation']='' ['refusals']=0 ['denials']=0 ['continuations']=0
    ['spent']=none)
  [ -e "$file" ] || [ -L "$file" ] || return 0
  raw=$(timeout "$READ_SECONDS" head -c $((RECORD_BYTES + 1)) -- "$file" 2>/dev/null | tr '\0' '\001' && printf x)
  rc=$?
  raw=${raw%x}
  [ "$rc" -ne 0 ] || mapfile -t lines <<< "${raw%$'\n'}"
  if [ "$rc" -ne 0 ] && [ ! -e "$file" ] && [ ! -L "$file" ]; then
    return 0
  elif [ "$rc" -eq 124 ]; then
    reason='the record read timed out' state=unreadable
  elif [ "$rc" -ne 0 ]; then
    reason='the record cannot be read' state=unreadable
  elif [ "${#raw}" -gt "$RECORD_BYTES" ]; then
    reason="the record is longer than $RECORD_BYTES bytes"
  elif [ -z "$raw" ]; then
    reason='the record is empty'
  elif [[ $raw != *$'\n' ]]; then
    reason='the last line has no newline'
  elif [ "${#lines[@]}" -eq 1 ]; then
    reason='the record has 1 line, not 5'
  elif [ "${#lines[@]}" -ne 5 ]; then
    reason="the record has ${#lines[@]} lines, not 5"
  elif ! [[ ${lines[0]} =~ $RECORD_GEN_RE ]]; then
    reason='line 1 is not generation=<generation> or generation='
  elif ! [[ ${lines[1]} =~ ^refusals=$COUNTER$ ]]; then
    reason='line 2 is not refusals=<n>'
  elif ! [[ ${lines[2]} =~ ^denials=$COUNTER$ ]]; then
    reason='line 3 is not denials=<n>'
  elif ! [[ ${lines[3]} =~ ^continuations=$COUNTER$ ]]; then
    reason='line 4 is not continuations=<n>'
  elif ! [[ ${lines[4]} =~ ^spent=(none|question|permission|continuation)$ ]]; then
    reason='line 5 is not spent=none, question, permission or continuation'
  fi
  if [ -n "$reason" ]; then
    rr['state']=$state rr['reason']=$reason
    return 0
  fi
  rr['state']=ok rr['generation']=${lines[0]#generation=} rr['refusals']=${lines[1]#refusals=}
  rr['denials']=${lines[2]#denials=} rr['continuations']=${lines[3]#continuations=} rr['spent']=${lines[4]#spent=}
}

# write_record FILE GENERATION REFUSALS DENIALS CONTINUATIONS SPENT: write the
# five lines to a temporary file beside FILE, rename it over FILE, and read
# FILE back into rb with read_record; exit 1 on a failure or a mismatch.
write_record() {
  local file=$1 tmp
  tmp=$(mktemp -- "${file%/*}/.noask.XXXXXX" 2>/dev/null) || die "cannot write $file"
  if ! printf 'generation=%s\nrefusals=%s\ndenials=%s\ncontinuations=%s\nspent=%s\n' "$2" "$3" "$4" "$5" "$6" \
    > "$tmp" 2>/dev/null || ! mv -fT -- "$tmp" "$file" 2>/dev/null; then
    rm -f -- "$tmp"
    die "cannot write $file"
  fi
  read_record "$file" rb
  { [ "${rb[state]}" = ok ] && [ "${rb[generation]}" = "$2" ] && [ "${rb[refusals]}" = "$3" ] &&
    [ "${rb[denials]}" = "$4" ] && [ "${rb[continuations]}" = "$5" ] && [ "${rb[spent]}" = "$6" ]; } ||
    die "$file does not read back as written"
}

# Remove each session marker that reads expired and each leftover temporary
# file in both directories, then sweep budgets.d; a failure changes nothing
# the command reports.
sweep() {
  local f
  local -A sw=()
  rm -f -- "$STATE"/.noask.* "$DIR"/.noask.* 2>/dev/null
  for f in "$DIR"/*; do
    [[ ${f##*/} =~ $ID_RE ]] || continue
    read_marker "$f" session sw
    [ "${sw[state]}" != expired ] || rm -f -- "$f" 2>/dev/null
  done
  sweep_records
  return 0
}

# The records' sweep, after the markers' and under the records' lock taken
# without waiting: remove each file of budgets.d but .lock whose generation=
# line names no marker that reads on now, and each leftover temporary file.
# Nothing is removed (or made) with no budgets.d, while the lock is busy,
# while a marker reads unreadable, or while noask.d exists and cannot be
# listed and searched (a marker hidden in it, or read as absent because it
# cannot be looked at): a record made under such a marker carries a
# generation no reading can match, and removing it would start a spent budget
# again.
sweep_records() {
  local f first keep g
  local -a live=()
  local -A sw=()
  [ -d "$BUDGETS" ] || return 0
  if [ -d "$DIR" ] && ! { [ -r "$DIR" ] && [ -x "$DIR" ]; }; then return 0; fi
  read_marker "$GLOBAL" global sw
  case ${sw[state]} in
    unreadable) return 0 ;;
    on) live+=("generation=${sw[generation]}") ;;
  esac
  for f in "$DIR"/*; do
    [[ ${f##*/} =~ $ID_RE ]] || continue
    read_marker "$f" session sw
    case ${sw[state]} in
      unreadable) return 0 ;;
      on) live+=("generation=${sw[generation]}") ;;
    esac
  done
  { exec 8>>"$BUDGETS/.lock"; } 2>/dev/null || return 0
  flock -n 8 || return 0
  rm -f -- "$BUDGETS"/.noask.* 2>/dev/null
  for f in "$BUDGETS"/* "$BUDGETS"/.[!.]* "$BUDGETS"/..?*; do
    [ "${f##*/}" != .lock ] || continue
    first=$(timeout "$READ_SECONDS" head -c "$RECORD_BYTES" -- "$f" 2>/dev/null | tr '\0' '\001')
    first=${first%%$'\n'*}
    keep=
    for g in "${live[@]}"; do
      [ "$first" != "$g" ] || keep=1
    done
    [ -n "$keep" ] || rm -f -- "$f" 2>/dev/null
  done
  return 0
}

print_rule() {
  local text
  if [ -f "$RULE" ] && text=$(cat -- "$RULE" 2>/dev/null); then
    printf '%s\n' "$text"
  else
    printf 'noask: rule text missing at %s; sessions get the short built-in text and rule nothing\n' "$RULE"
  fi
}

# session_reading: read the global marker into gm and, with an S, S's own
# into sm; set the caller's reading to the name of the one whose state is
# S's reading, and its reading_state and reading_generation to that state
# and generation.
session_reading() {
  reading=gm
  read_marker "$GLOBAL" global gm
  if [ -n "$session" ]; then
    read_marker "$DIR/$session" session sm
    if [ "${gm[state]}" != on ] && [ "${gm[state]}" != unreadable ] && [ "${sm[state]}" != off ]; then
      reading=sm
    fi
  fi
  local -n sn=$reading
  reading_state=${sn[state]} reading_generation=${sn[generation]}
}

cmd_status() {
  local reading reading_state reading_generation line
  session_reading
  local -n r=$reading
  case ${r[state]} in
    off) line=off ;;
    on) line="on ${r[generation]}${r[until]:+ until ${r[until]}}" ;;
    expired) line="expired ${r[until]}" ;;
    unreadable) line="unreadable ${r[reason]}" ;;
  esac
  if [ -n "$session" ] && [ "${sm[state]}" = on ] && [ "${sm[level]}" = handsoff ]; then
    line+=' handsoff'
  fi
  printf '%s\n' "$line"
  [ "${r[state]}" != unreadable ] || exit 3
}

# The bare command in a session: a line for each switch that is on.
cmd_show_session() {
  local rc=0 shown_any=
  read_marker "$GLOBAL" global gm
  read_marker "$DIR/$session" session sm
  case ${gm[state]} in
    on) echo "noask: on for every session $(span gm)"; shown_any=1 ;;
    unreadable)
      echo "noask: unreadable (${gm[reason]}); sessions treat it as on; noask global off removes it"
      shown_any=1 rc=3
      ;;
  esac
  case ${sm[state]} in
    on) echo "noask: $(word sm) for this session $(span sm)"; shown_any=1 ;;
    unreadable)
      echo "noask: this session's marker is unreadable (${sm[reason]}); the session treats it as on; /noask off removes it"
      shown_any=1 rc=3
      ;;
  esac
  if [ -z "$shown_any" ]; then
    if [ "${sm[state]}" = expired ]; then
      echo "noask: off (expired ${sm[until_at]})"
    elif [ "${gm[state]}" = expired ]; then
      echo "noask: off (expired ${gm[until_at]})"
    else
      echo 'noask: off'
    fi
  fi
  exit "$rc"
}

# The bare command in a terminal: the global switch's line, then the
# sessions' own switches that are on, then those that are unreadable.
cmd_show_terminal() {
  local rc=0 f id
  local -a unreadable=()
  read_marker "$GLOBAL" global gm
  case ${gm[state]} in
    on) echo "noask: on for every session $(span gm)" ;;
    off) echo 'noask: off' ;;
    expired) echo "noask: off (expired ${gm[until_at]})" ;;
    unreadable)
      echo "noask: unreadable (${gm[reason]}); sessions treat it as on; noask global off removes it"
      rc=3
      ;;
  esac
  for f in "$DIR"/*; do
    id=${f##*/}
    [[ $id =~ $ID_RE ]] || continue
    read_marker "$f" session om
    case ${om[state]} in
      on) echo "noask: $(word om) for session $id $(span om)" ;;
      unreadable) unreadable+=("noask: session $id has an unreadable marker (${om[reason]})") rc=3 ;;
    esac
  done
  [ "${#unreadable[@]}" -eq 0 ] || printf '%s\n' "${unreadable[@]}"
  exit "$rc"
}

cmd_global_on() {
  take_lock
  read_marker "$GLOBAL" global gm
  if [ "${gm[state]}" = on ] && [ -z "$expiry" ]; then
    echo "noask: already on for every session $(span gm); nothing changed"
  elif [ "${gm[state]}" = on ]; then
    write_marker "$GLOBAL" global "${gm[generation]}" "${gm[since]}" "$until_new" noask
    echo "noask: on for every session $(span wm) (expiry renewed)"
    echo "marker: $GLOBAL"
  else
    new_generation
    write_marker "$GLOBAL" global "$generation_new" "$stamp" "$until_new" noask
    echo "noask: on for every session $(span wm)"
    echo "marker: $GLOBAL"
    echo
    print_rule
  fi
  sweep
}

cmd_session_on() {
  local target=$DIR/$session also='' level=noask note='' until
  take_lock
  read_marker "$target" session sm
  read_marker "$GLOBAL" global gm
  case ${gm[state]} in
    on) also="; also on for every session $(span gm)" ;;
    unreadable)
      also="; the global marker is unreadable (${gm[reason]}) and holds every session under noask; noask global off removes it"
      ;;
  esac
  [ -z "$handsoff" ] || level=handsoff
  if [ "${sm[state]}" = on ]; then
    [ "${sm[level]}" != handsoff ] || level=handsoff
    if [ "$level" = "${sm[level]}" ] && [ -z "$expiry" ]; then
      echo "noask: already $(word sm) for this session $(span sm); nothing changed$also"
    else
      if [ "$level" != "${sm[level]}" ]; then note=' (level raised'; else note=' (expiry'; fi
      if [ -n "$expiry" ]; then
        until=$until_new
        if [ "$level" != "${sm[level]}" ]; then note+=', expiry renewed)'; else note+=' renewed)'; fi
      else
        until=${sm[until]}
        note+=')'
      fi
      write_marker "$target" session "${sm[generation]}" "${sm[since]}" "$until" "$level"
      echo "noask: $(word wm) for this session $(span wm)$note$also"
      echo "marker: $target"
    fi
  else
    until=$until_new
    if [ -z "$expiry" ]; then
      until=$(iso_of $((now + SESSION_HOURS * 3600))) || die 'cannot read the clock'
      note=" ($SESSION_HOURS hours by default; /noask on <expiry> sets another)"
    fi
    mkdir -m 700 -- "$DIR" 2>/dev/null # its parent, the state directory, take_lock made
    [ -d "$DIR" ] || die "cannot make $DIR"
    new_generation
    write_marker "$target" session "$generation_new" "$stamp" "$until" "$level"
    echo "noask: $(word wm) for this session $(span wm)$note$also"
    echo "marker: $target"
    echo
    print_rule
  fi
  sweep
}

cmd_global_off() {
  local line f n=0
  take_lock
  read_marker "$GLOBAL" global gm
  case ${gm[state]} in
    off) line='noask: already off for every session' ;;
    on) remove_marker "$GLOBAL"; line='noask: off for every session' ;;
    expired)
      remove_marker "$GLOBAL"
      line="noask: off for every session (expired ${gm[until_at]}; marker removed)"
      ;;
    unreadable) remove_marker "$GLOBAL"; line='noask: off for every session (unreadable marker removed)' ;;
  esac
  if [ -n "$session" ]; then
    read_marker "$DIR/$session" session sm
    case ${sm[state]} in
      on) line+="; still $(word sm) for this session until ${sm[until_at]}; /noask off ends that" ;;
      unreadable)
        line+="; this session's marker is unreadable (${sm[reason]}) and treated as on; /noask off removes it"
        ;;
    esac
  else
    for f in "$DIR"/*; do
      [[ ${f##*/} =~ $ID_RE ]] || continue
      read_marker "$f" session om
      [ "${om[state]}" != on ] && [ "${om[state]}" != unreadable ] || n=$((n + 1))
    done
    [ "$n" -eq 0 ] || line+="; sessions still on by their own switch: $n (noask lists them)"
  fi
  printf '%s\n' "$line"
  sweep
}

cmd_session_off() {
  local target=$DIR/$session line
  take_lock
  read_marker "$target" session sm
  case ${sm[state]} in
    off) line='noask: already off for this session' ;;
    on) remove_marker "$target"; line='noask: off for this session' ;;
    expired)
      remove_marker "$target"
      line="noask: off for this session (expired ${sm[until_at]}; marker removed)"
      ;;
    unreadable) remove_marker "$target"; line='noask: off for this session (unreadable marker removed)' ;;
  esac
  read_marker "$GLOBAL" global gm
  case ${gm[state]} in
    on) line+="; still on for every session $(span gm); noask global off ends that" ;;
    unreadable)
      line+="; still treated as on for every session: unreadable marker (${gm[reason]}); noask global off removes it"
      ;;
  esac
  printf '%s\n' "$line"
  sweep
}

# count: charge count_word to the record of S, or of S's subagent, under S's
# reading, as the header says.
cmd_count() {
  local file=$BUDGETS/$session${agent:+.$agent} reading reading_state reading_generation wait rc=0 counter='' spent=''
  session_reading
  case $reading_state in off | expired) echo off; return ;; esac
  lock_wait "$COUNT_LOCK_SECONDS"
  mkdir -m 700 -- "$BUDGETS" 2>/dev/null # the state directory exists: the marker just read is in it
  [ -d "$BUDGETS" ] || die "cannot make $BUDGETS"
  { exec 8>>"$BUDGETS/.lock"; } 2>/dev/null || die "cannot open the lock $BUDGETS/.lock"
  flock -w "$wait" 8 || rc=$?
  case $rc in
    0) ;;
    1) die 'the records are locked by another noask command' ;;
    *) die "cannot take the lock $BUDGETS/.lock" ;;
  esac
  session_reading
  case $reading_state in off | expired) echo off; return ;; esac
  read_record "$file" rec
  [ "${rec[state]}" != unreadable ] || die "cannot read $file (${rec[reason]})"
  local note=${rec[reason]} # set when the record did not parse; said once the count has succeeded
  if [ "$reading_state" = on ] && [ "${rec[generation]}" != "$reading_generation" ]; then
    rec=(['generation']=$reading_generation ['refusals']=0 ['denials']=0 ['continuations']=0 ['spent']=none)
  fi
  case $count_word in
    question) counter=refusals spent=question ;;
    denial) counter=denials spent=permission ;;
    continuation) counter=continuations spent=continuation ;;
    reset) if [ "${rec[spent]}" = none ]; then rec['refusals']=0 rec['denials']=0 rec['continuations']=0; fi ;;
  esac
  if [ -n "$counter" ] && [ "${rec[spent]}" = none ]; then
    rec[$counter]=$((rec[$counter] + 1))
    [ "${rec[$counter]}" -lt "$budget" ] || rec['spent']=$spent
  fi
  if [ "$count_word" != read ]; then
    write_record "$file" "${rec[generation]}" "${rec[refusals]}" "${rec[denials]}" "${rec[continuations]}" \
      "${rec[spent]}"
  fi
  if [ -n "$note" ] && [ "$count_word" = read ]; then
    printf 'noask: the record %s did not parse (%s); read as an empty one, left as it is\n' "$file" "$note" >&2
  elif [ -n "$note" ]; then
    printf 'noask: the record %s did not parse (%s); started again\n' "$file" "$note" >&2
  fi
  printf 'counted %s %s %s %s\n' "${rec[spent]}" "${rec[refusals]}" "${rec[denials]}" "${rec[continuations]}"
}

# The hook entries and start-line. An entry's steps, in this order: the plain
# trap (set where the form is told apart), read_input, entry_reading, its
# event's inert returns, the inputs of its failure answer, guard_entry,
# rule_text when it uses the rule, then its work, which ends in answer or
# allow, each called in the entry's own shell, never inside a command
# substitution, where its mark would be lost. Every variable a failure answer
# reads is set here, so none is unset when the exit trap runs.
input='' usable='' has_jq='' agent_present='' agent_shown='' id_reason='' option_value=''
reading='' reading_state='' reading_generation='' reading_reason='' reading_level=''
answered='' failure='' signalled='' rule='' rule_missing='' line='' role_text=''
count_result='' count_cause='' count_continuations='' count_error='' count_note=''

# read_input: read standard input once, as a marker is read (NUL bytes become
# \001, so such an input is not JSON), to one byte past INPUT_BYTES and
# within READ_SECONDS times 2, into input (left empty when the read timed out
# or the input is longer). Set has_jq (jq is on PATH), usable (the input is
# exactly one JSON object), session and agent (the input's session_id and
# agent_id when each is a JSON string of the id's form, the session's none of
# RESERVED; else empty), agent_present (agent_id is there and not null),
# agent_shown (what the text for an unusable agent id shows: the string, or
# another type's compact JSON, cut to 64 characters) and id_reason (why the
# input gives no usable session id, empty when it gives one). A read that
# fails otherwise gives nothing, as an empty input does.
read_input() {
  local raw rc kind why=''
  input='' usable='' session='' agent='' agent_present='' agent_shown='' id_reason='' has_jq=''
  ! command -v jq > /dev/null 2>&1 || has_jq=1
  raw=$(timeout $((READ_SECONDS * 2)) head -c $((INPUT_BYTES + 1)) 2>/dev/null | tr '\0' '\001' && printf x)
  rc=$?
  if [ "$rc" -eq 124 ]; then
    why='the input read timed out'
  elif [ "$rc" -ne 0 ]; then
    why='the input is empty'
  elif [ "$((${#raw} - 1))" -gt "$INPUT_BYTES" ]; then
    why='the input is longer than 4 MiB'
  else
    input=${raw%x}
    [ -n "$input" ] || why='the input is empty'
  fi
  [ -n "$why" ] || [ -n "$has_jq" ] || why='jq is missing'
  if [ -z "$why" ]; then
    # Two words: the session id's kind, then the agent id's, or one word for an input that is not one object.
    kind=$(printf '%s' "$input" | jq -rs --arg re "$JQ_ID_RE" '
      if length == 1 and (.[0] | type) == "object" then .[0] |
        (if (.session_id | type) != "string" then "none" elif (.session_id | test($re)) then "good" else "bad" end),
        (if .agent_id == null then "absent" elif (.agent_id | type) == "string" and (.agent_id | test($re))
          then "good" else "bad" end)
      else "other" end' 2>/dev/null) || kind=''
    case $kind in
      none$'\n'* | good$'\n'* | bad$'\n'*) usable=1 ;;
      *) why='the input is not JSON' ;;
    esac
  fi
  if [ -n "$usable" ]; then
    case ${kind%%$'\n'*} in
      none) why='the input has no session_id' ;;
      good)
        session=$(field .session_id)
        if ! is_session_id "$session"; then
          id_reason="this session's id is not usable ($session)" session=''
        fi
        ;;
      bad) { id_reason="this session's id is not usable ($(field .session_id))"; } 2>/dev/null ;;
    esac
    case ${kind#*$'\n'} in
      good) agent=$(field .agent_id) agent_present=1 agent_shown=$agent ;;
      bad)
        agent_present=1
        { agent_shown=$(field '.agent_id | (if type == "string" then . else tojson end) | .[0:64]'); } 2>/dev/null
        ;;
    esac
  fi
  [ -z "$why" ] || id_reason="this session's id could not be read ($why)"
}

# field FILTER: print FILTER's raw output (jq -r) on the input, which jq reads
# on its standard input; nothing when jq is missing, the input is not usable
# or jq fails.
field() {
  local out
  { [ -n "$has_jq" ] && [ -n "$usable" ]; } || return 0
  out=$(printf '%s' "$input" | jq -r "$1" 2>/dev/null) || return 0
  [ -z "$out" ] || printf '%s\n' "$out"
}

# entry_reading: the entry's reading of S, session_reading's with a session
# id; without one the no-id rule's: the global marker's when that is on or
# unreadable; else unreadable when noask.d exists and cannot be listed or
# searched (the sweep's test), or when a marker in noask.d reads on or
# unreadable, the look stopping at the first such marker, whose state names
# the reason's tail; else the global marker's. With an id, a marker under a
# noask.d that cannot be searched reads off, as session_reading reads it.
# Sets reading (gm, sm, or noid for the no-id rule's own unreadable),
# reading_state, reading_generation, reading_reason (an unreadable reading's
# reason) and reading_level (handsoff when S's own marker reads on at that
# level, else noask).
# shellcheck disable=SC2034 # reading_level is for the entries that look at the level
entry_reading() {
  local f
  reading_level=noask
  if [ -n "$session" ]; then
    session_reading
    local -n er=$reading
    reading_reason=${er[reason]}
    if [ "${sm[state]}" = on ] && [ "${sm[level]}" = handsoff ]; then reading_level=handsoff; fi
    return 0
  fi
  read_marker "$GLOBAL" global gm
  reading=gm reading_state=${gm[state]} reading_generation=${gm[generation]} reading_reason=${gm[reason]}
  case $reading_state in on | unreadable) return 0 ;; esac
  if [ -d "$DIR" ] && ! { [ -r "$DIR" ] && [ -x "$DIR" ]; }; then
    reading=noid reading_state=unreadable reading_generation='' reading_reason='noask.d cannot be listed or searched'
    return 0
  fi
  for f in "$DIR"/*; do
    [[ ${f##*/} =~ $ID_RE ]] || continue
    read_marker "$f" session om
    case ${om[state]} in
      on) reading_reason="$id_reason while a session's own switch is on" ;;
      unreadable) reading_reason="$id_reason while a session's own marker is unreadable" ;;
      *) continue ;;
    esac
    reading=noid reading_state=unreadable reading_generation=''
    return 0
  done
}

# json_string TEXT: print TEXT as a JSON string with its quotes: \, " and
# every byte below 0x20 escaped, every other byte as it is.
json_string() {
  local s=$1 i hex c e bs="\\\\" qt="\\\"" nl="\\n" tb="\\t" cr="\\r"
  s=${s//\\/"$bs"}
  s=${s//\"/"$qt"}
  s=${s//$'\n'/"$nl"}
  s=${s//$'\t'/"$tb"}
  s=${s//$'\r'/"$cr"}
  if [[ $s == *[$'\001'-$'\037']* ]]; then
    for ((i = 1; i < 32; i++)); do
      printf -v hex %02x "$i"
      printf -v c '%b' "\\x$hex"
      printf -v e '\\u%04x' "$i"
      s=${s//"$c"/"$e"}
    done
  fi
  printf '"%s"' "$s"
}

# rule_text: set rule to the rule file's text, read as a marker is (within
# READ_SECONDS, NUL bytes as \001, no test of the file's type first, so a
# FIFO there costs its wait), without the newlines that end it, and
# rule_missing to empty; or, when the file cannot be read or is longer than
# RULE_BYTES, rule to FALLBACK_RULE and rule_missing to 1. Prints nothing.
rule_text() {
  local raw rc
  rule=$FALLBACK_RULE rule_missing=1
  raw=$(timeout "$READ_SECONDS" head -c $((RULE_BYTES + 1)) -- "$RULE" 2>/dev/null | tr '\0' '\001' && printf x)
  rc=$?
  if [ "$rc" -ne 0 ] || [ "$((${#raw} - 1))" -gt "$RULE_BYTES" ]; then return 0; fi
  raw=${raw%x}
  rule=${raw%"${raw##*[!$'\n']}"} rule_missing=''
}

# answer JSON: the entry's one answer. TERM, INT and HUP are ignored from
# here on; the line JSON is printed with one printf unless the entry has
# answered or allowed already; the entry is marked answered; and standard
# output points at /dev/null, so nothing the entry runs after it can add a
# line. Standard output is never closed: a closed descriptor 1 is handed to
# the next file a child opens.
answer() {
  trap '' TERM INT HUP
  [ -n "$answered" ] || printf '%s\n' "$1"
  answered=1
  { exec > /dev/null; } 2>/dev/null
}
# allow: the entry ends without an answer, which allows what its event asks;
# nothing is printed.
# shellcheck disable=SC2329 # for the entries that allow
allow() { answered=1; }

# guard_entry FUNCTION: from here on the entry does not end unanswered. Each
# of TERM, INT and HUP records `ended by a signal` and exits 0. On exit the
# trap ignores the three signals, calls FUNCTION with the failure's message
# when the entry is not marked answered (the one a die left, else the
# signal's, else `ended without an answer`; FUNCTION ends in answer or
# allow), and exits 0, so a die in the entry does not leave status 1.
guard_entry() {
  failure=$1
  trap 'signalled="ended by a signal"; exit 0' TERM INT HUP
  trap guard_exit EXIT
}
# shellcheck disable=SC2329 # the exit trap calls it
guard_exit() {
  trap '' TERM INT HUP
  [ -n "$answered" ] || "$failure" "${died:-${signalled:-ended without an answer}}"
  exit 0
}

# option KEY DEFAULT: set option_value to the plugin option KEY as the host
# passes it, in CLAUDE_PLUGIN_OPTION_<KEY>, or to DEFAULT when that variable
# is absent. Set, not printed: a command substitution would drop the value's
# final newlines, and an option is compared to a word exactly.
option() {
  local name=CLAUDE_PLUGIN_OPTION_$1
  if [ -n "${!name+set}" ]; then option_value=${!name}; else option_value=$2; fi
}
# budget_of KEY DEFAULT: print the budget option KEY, or DEFAULT when the
# option is absent or its value is not ^[1-9][0-9]{0,4}$.
budget_of() {
  option "$1" "$2"
  if [[ $option_value =~ ^[1-9][0-9]{0,4}$ ]]; then printf '%s\n' "$option_value"; else printf '%s\n' "$2"; fi
}

# entry_count WORD BUDGET: count WORD (denial, continuation or reset) against
# BUDGET on the record of the entry's S, or of its subagent, by cmd_count run
# in a command substitution with its standard error joined to its output: a
# die there ends that subshell alone, and the entry's own reading stands. Of
# that output, the line that starts `counted ` or is `off` is the result, and
# the first line with the `noask: ` head is the error (after a status that is
# not 0) or the note (after 0). Sets count_result to counted, off (the
# marker went off or expired after the entry's reading: cmd_count reads it
# again) or failed; count_cause and count_continuations to the counted line's
# second and fifth words; count_error after a failure and count_note after a
# count that succeeded, each that line without its head (a failure without
# one says how the count exited, as the module's caller does). An entry
# counts before it answers: under uutils' timeout a bounded read started
# once answer has ignored TERM is not stopped at its bound.
# shellcheck disable=SC2034 # count_continuations is for the stop entry
entry_count() {
  local out rc=0 l result='' said=''
  local -a lines=()
  count_result=failed count_cause='' count_continuations='' count_error='' count_note=''
  out=$(
    count_word=$1 budget=$2
    cmd_count 2>&1
  ) || rc=$?
  mapfile -t lines <<< "$out"
  for l in "${lines[@]}"; do
    case $l in
      'counted '* | off) [ -n "$result" ] || result=$l ;;
      'noask: '*) [ -n "$said" ] || said=${l#noask: } ;;
    esac
  done
  if [ "$rc" -ne 0 ]; then
    count_error=${said:-the count exited $rc}
  elif [ "$result" = off ]; then
    count_result=off
  elif [[ $result =~ ^counted\ (none|question|permission|continuation)\ [0-9]+\ [0-9]+\ ([0-9]+)$ ]]; then
    count_result=counted count_cause=${BASH_REMATCH[1]} count_continuations=${BASH_REMATCH[2]} count_note=$said
  else
    count_error='the count printed no result'
  fi
}

# count_denial: count a denial for the permission or the elicitation entry
# against the denialBudget option, by entry_count; or, where there is no
# record to count on, set count_result to failed with why and count nothing:
# without a usable session id, and with an agent id of another form (the
# session's own record is not touched then either).
count_denial() {
  if [ -z "$session" ]; then
    count_result=failed count_error='no session id'
  elif [ -n "$agent_present" ] && [ -z "$agent" ]; then
    count_result=failed count_error="the agent id is not usable ($agent_shown)"
  else
    entry_count denial "$(budget_of DENIALBUDGET 10)"
  fi
}

# ending_text WHICH: the main session's text once the budget WHICH is spent
# (endingText of hooks/text.ts).
# shellcheck disable=SC2016 # its backquotes are the text's, not substitutions
ending_text() {
  printf 'end this turn with the list Rulings I made and the line `noask: blocked: %s budget exhausted`' "$1"
}

# start_line: set line to the line a session shows at its start under the
# reading entry_reading took, then the notes that hold (jq not on PATH, by
# has_jq; the rule file unreadable, by rule_missing), each after one space;
# or to nothing when the reading is off or expired. Under the global
# marker's reading S's own switch that reads on adds its sentence. line is
# set once, when it is whole.
start_line() {
  local text=''
  line=''
  case $reading_state in off | expired) return 0 ;; esac
  case $reading in
    noid) text="noask treats this session as ON: $reading_reason" ;;
    gm)
      if [ "${gm[state]}" = on ]; then
        text="noask is ON for every session $(span gm)"
      else
        text="noask is ON for every session (noask marker unreadable: ${gm[reason]}; treated as on)"
      fi
      text+='; sessions rule on their own recommendations and never wait; noask global off to end it'
      if [ -n "$session" ] && [ "${sm[state]}" = on ] && [ "${sm[level]}" = handsoff ]; then
        text+=" This session's own switch is on too, with handsoff, until ${sm[until_at]}: it may push and open a request; /noask off ends that one."
      elif [ -n "$session" ] && [ "${sm[state]}" = on ]; then
        text+=" This session's own switch is on too until ${sm[until_at]}; /noask off ends that one."
      fi
      ;;
    sm)
      if [ "${sm[state]}" = unreadable ]; then
        text="noask is ON for this session (noask marker unreadable: ${sm[reason]}; treated as on); it rules on its own recommendations and never waits; /noask off to end it"
      elif [ "${sm[level]}" = handsoff ]; then
        text="noask is ON with handsoff for this session $(span sm); it rules on its own recommendations, never waits, and may push and open a request; /noask off to end it"
      else
        text="noask is ON for this session $(span sm); it rules on its own recommendations and never waits; /noask off to end it"
      fi
      ;;
  esac
  [ -n "$has_jq" ] ||
    text+=" jq is not on PATH, so noask's hooks cannot tell this session from another: while any noask switch is on they act in every session, and a stop is continued once."
  [ -z "$rule_missing" ] || text+=' The rule file could not be read, so sessions rule nothing and block every choice.'
  line=$text
}

# start-line: S's start line, or a session's with no id, with its notes;
# nothing when that reading is off or expired. It reads no input, so whether
# jq is on PATH is its own look.
cmd_start_line() {
  ! command -v jq > /dev/null 2>&1 || has_jq=1
  id_reason="this session's id could not be read (no id was given)"
  entry_reading
  case $reading_state in off | expired) return 0 ;; esac
  rule_text
  start_line
  printf '%s\n' "$line"
}

# session_start_answer MESSAGE CONTEXT: answer the SessionStart object.
session_start_answer() {
  local json
  printf -v json '{"systemMessage":%s,"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":%s}}' \
    "$(json_string "$1")" "$(json_string "$2")"
  answer "$json"
}
# The session start's failure answer, for the message MESSAGE: the start line
# when it was built, else `noask is ON`, with why the hook failed; and the
# rule text read so far, else the built-in one, as the context.
# shellcheck disable=SC2329 # guard_entry's exit trap calls it
session_start_failed() {
  session_start_answer "sdd: ${line:-noask is ON} (noask hook failed: $1)" "$rule"
}
# hook session-start: under a reading of on or unreadable, the start line
# with its notes as the message, and the rule text, an empty line and where
# the apply skill's noask reference is as the context.
hook_session_start() {
  read_input
  entry_reading
  case $reading_state in off | expired) return 0 ;; esac # inert: nothing printed, no file made, no lock taken
  line='' rule=$FALLBACK_RULE
  guard_entry session_start_failed
  rule_text
  start_line
  session_start_answer "sdd: $line" "$rule"$'\n\n'"The noask reference of the apply skill is $ROOT/skills/apply/references/noask.md. If you drive an apply run, re-read the noask reference now."
}

# permission_answer TEXT: answer the PermissionRequest deny object, its
# message TEXT with an unreadable reading's reason after it.
permission_answer() {
  local text=$1 json
  [ "$reading_state" != unreadable ] || text+=" (noask marker unreadable: $reading_reason; treated as on)"
  printf -v json '{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"deny","message":%s}}}' \
    "$(json_string "$text")"
  answer "$json"
}
# The permission entry's failure answer, for the message MESSAGE: the role's
# text with why the hook failed. It counts nothing: under uutils' timeout a
# bounded read started after the exit trap has ignored TERM is not stopped at
# its bound.
# shellcheck disable=SC2329 # guard_entry's exit trap calls it
permission_failed() {
  permission_answer "$role_text (noask hook failed: $1)"
}
# hook permission: under a reading of on or unreadable, with the
# permissionHook option not exactly false, count the denial, then deny: the
# role's text (PERMISSION_TEXT for the main session, SUBAGENT_TEXT for a
# subagent, by an agent_id that is there), or once the budget is spent the
# ending text for its cause or SUBAGENT_SPENT_TEXT, then the count's failure
# or its note. A count that gave off leaves the role's text and the entry's
# own reading.
hook_permission() {
  local text
  read_input
  entry_reading
  case $reading_state in off | expired) return 0 ;; esac # inert: nothing printed, no file made, no lock taken
  option PERMISSIONHOOK true
  [ "$option_value" != false ] || return 0 # inert: the owner turned the hook off
  if [ -n "$agent_present" ]; then role_text=$SUBAGENT_TEXT; else role_text=$PERMISSION_TEXT; fi
  guard_entry permission_failed
  count_denial
  text=$role_text
  if [ "$count_result" = counted ] && [ "$count_cause" != none ]; then
    if [ -n "$agent_present" ]; then text=$SUBAGENT_SPENT_TEXT; else text=$(ending_text "$count_cause"); fi
  fi
  case $count_result in
    failed) text+=" (noask count failed: $count_error)" ;;
    counted) [ -z "$count_note" ] || text+=" (noask count: $count_note)" ;;
  esac
  permission_answer "$text"
}

# elicitation_decline: answer the Elicitation decline object, which carries
# no text; it is also the entry's failure answer, for any message.
elicitation_decline() {
  answer '{"hookSpecificOutput":{"hookEventName":"Elicitation","action":"decline"}}'
}
# hook elicitation: as hook permission up to the count, then decline whatever
# the count gave: the host shows a reason to nobody at this event.
hook_elicitation() {
  read_input
  entry_reading
  case $reading_state in off | expired) return 0 ;; esac # inert: nothing printed, no file made, no lock taken
  option PERMISSIONHOOK true
  [ "$option_value" != false ] || return 0 # inert: the owner turned the hook off
  guard_entry elicitation_decline
  count_denial
  elicitation_decline
}

# hook EVENT: the entry of EVENT; stop answers nothing here.
cmd_hook() {
  case $event in
    session-start) hook_session_start ;;
    permission) hook_permission ;;
    elicitation) hook_elicitation ;;
  esac
}

case $action/$scope in
  status/) cmd_status ;;
  count/) cmd_count ;;
  hook/) cmd_hook ;;
  start-line/) cmd_start_line ;;
  show/) if [ -n "$session" ]; then cmd_show_session; else cmd_show_terminal; fi ;;
  on/global) cmd_global_on ;;
  on/session) cmd_session_on ;;
  off/global) cmd_global_off ;;
  off/session) cmd_session_off ;;
esac
[ "${#narrowed[@]}" -eq 0 ] || printf '%s\n' "${narrowed[@]}"
exit 0
