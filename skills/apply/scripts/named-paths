#!/usr/bin/env bash
# Print the file paths a Markdown text names in backticks. The OpenSpec
# brief script runs it on one section of a change's tasks.md, and the
# driver runs it on the whole tasks.md at launch.
#
# The rule. In the text outside code fences, a backtick span is a named path
# when all of these hold:
#   1. it has no whitespace, none of ( ) < > { } [ ] * ? = , ; ' " | \,
#      no :: and no ://, does not start with - $ ~ / or @, and does not end
#      with /;
#   2. after dropping a :N or :N-M suffix and a leading ./, it holds a / or
#      ends in an extension of one to eight letters and digits that starts
#      with a letter;
#   3. relative to the repository root it is a file, or it does not exist,
#      holds a / and its folder exists (a file the section will create). A
#      folder is never a named path.
# Words outside backticks are not read. A span runs from a backtick to the
# next backtick on the same line; an empty span is dropped, and a last
# backtick without a partner opens nothing. A fence line is one whose first
# non-blank characters are ``` or ~~~, indented or not. It opens a fence
# that the next fence line of the same character closes; a fence line of
# the other character inside it is code, and a fence never closed runs to
# the end of the text. Fence lines are not read for spans.
#
# Measured on 2026-11-13 over 635 OpenSpec task files: 55% of the sections
# with checkbox items name at least one path by this rule.
#
# Usage: named-paths FILE
#   FILE - reads standard input.
# Prints each named path once, in its cleaned form (the :N or :N-M suffix
# and a leading ./ dropped), one per line, in first-seen order. The disk
# test of clause 3 runs against the root of the repository holding the
# current folder.
# Exit codes: 0, also when nothing is printed; 2 usage, a missing FILE, or a
# current folder in no repository (a message on stderr, nothing on stdout).
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: named-paths FILE (- for standard input)" >&2
  exit 2
fi
file=$1
if [ "$file" != - ] && { [ ! -r "$file" ] || [ -d "$file" ]; }; then
  echo "not a readable file: $file" >&2
  exit 2
fi
root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "not in a git repository: $PWD" >&2
  exit 2
}
[ "$file" = - ] || exec < "$file"

# The spans outside fences, one per line.
spans=$(awk '
  {
    lead = $0
    sub(/^[[:blank:]]+/, "", lead)
    mark = substr(lead, 1, 3)
    if (mark == "```" || mark == "~~~") {
      if (fence == "") fence = mark
      else if (mark == fence) fence = ""
      next
    }
    if (fence != "") next
    n = split($0, part, "`")
    for (i = 2; i < n; i += 2)
      if (part[i] != "") print part[i]
  }
')

# Clause 1, on the span as written: any match rules the span out.
ruled_out='[[:space:]]|[][(){}<>*?=,;'\''"|\]|::|://|^[-$~/@]|/$'
# Clause 2's extension, on the cleaned form.
extension='\.[A-Za-z][A-Za-z0-9]{0,7}$'
declare -A seen=()

while IFS= read -r span; do
  [ -n "$span" ] || continue
  [[ $span =~ $ruled_out ]] && continue
  path=$span
  [[ $path =~ ^(.*):[0-9]+(-[0-9]+)?$ ]] && path=${BASH_REMATCH[1]}
  path=${path#./}
  [[ $path == */* || $path =~ $extension ]] || continue
  [ -z "${seen[$path]+x}" ] || continue
  if [ -f "$root/$path" ] ||
     { [[ $path == */* ]] && [ ! -e "$root/$path" ] && [ -d "$root/${path%/*}" ]; }; then
    seen[$path]=1
    printf '%s\n' "$path"
  fi
done <<< "$spans"
